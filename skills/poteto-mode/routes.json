{
  "version": 1,
  "routes": ["lightweight", "standard", "intensive"],
  "facts": ["consequence", "reach", "uncertainty", "complexity", "reversibility"],
  "panels": ["architect", "arena", "interrogate", "swarm"],
  "lightweight_keeps": ["spec-probes", "principle-prove-it-works", "principle-test-behavior-not-implementation", "poteto-tdd", "benchmark-checklist"],
  "gates": [
    {
      "id": "preserve",
      "applies": "code",
      "when": {
        "all": "before every commit"
      },
      "run": "python3 \"${PSTACK_SKILLS_ROOT:?}/pstack-harness/scripts/preserve.py\" --since <start commit>"
    },
    {
      "id": "cleanup",
      "skill": "deslop",
      "applies": "code",
      "when": {
        "lightweight": "before each push or published head",
        "standard": "before each push or published head",
        "intensive": "before every commit or amend"
      }
    },
    {
      "id": "comment-prose",
      "skill": "unslop",
      "applies": "code",
      "when": {
        "lightweight": "before each push or published head",
        "standard": "before each push or published head",
        "intensive": "before every commit or amend"
      }
    },
    {
      "id": "comments",
      "skill": "no-comments",
      "applies": "code",
      "when": {
        "all": "before review, when the diff adds or changes comments, doc comments, docstrings, or lint or type suppressions"
      }
    },
    {
      "id": "commit-and-pr-prose",
      "skill": "technical-writing",
      "applies": "code",
      "when": {
        "all": "for docs, RFCs, readmes, PR titles, PR descriptions, and commit bodies"
      }
    },
    {
      "id": "documentation",
      "skill": "documentation-impact",
      "applies": "code",
      "when": {
        "all": "before reporting a substantive code or public workflow change complete"
      }
    },
    {
      "id": "reply-prose",
      "skill": "unslop",
      "applies": "all",
      "when": {
        "all": "on every prose surface, the reply included"
      }
    },
    {
      "id": "recap",
      "skill": "pr-recap",
      "applies": "code",
      "when": {
        "all": "only when the user or the repository's contributor instructions ask for PR recaps"
      }
    }
  ],
  "playbooks": {
    "bug-fix": {
      "changes_code": true,
      "tiered": true
    },
    "feature": {
      "changes_code": true,
      "tiered": true,
      "lightweight_worklist": [
        {
          "item": "Risk and acceptance",
          "covers": ["Preserved", "Shaped", "Specified"]
        },
        {
          "item": "Build and prove",
          "covers": ["Built", "Proven"]
        },
        {
          "item": "Deliver with review status",
          "covers": ["Landed", "Published"]
        }
      ],
      "lightweight_skips": {
        "Designed": "one established shape",
        "Planned": "no concurrent writes or independent streams"
      }
    },
    "refactoring": {
      "changes_code": true,
      "tiered": true
    },
    "perf-issue": {
      "changes_code": true,
      "tiered": true
    },
    "hillclimb": {
      "changes_code": true
    },
    "visual-parity": {
      "changes_code": true
    },
    "authoring-a-skill": {
      "changes_code": true
    }
  }
}
