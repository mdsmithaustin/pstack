+# POST .../messages/bulk-delete takes 2-100 message ids, all younger than 14 days; Discord rejects
+# the whole request otherwise (error codes 50016 and 50034).
+_BULK_DELETE_MAX_AGE_SECONDS = 14 * 24 * 3600
+
+
+def _purge_messages(token: str, channel_id: str, limit: int = 50, **_kwargs: Any) -> str:
+    """Delete the channel's newest ``limit`` messages (max 100) in one request. Messages older than
+    14 days are left in place and counted. A lone deletable message goes through the per-message
+    DELETE, because bulk delete needs at least two ids."""
+    messages = _discord_request(
+        "GET", f"/channels/{channel_id}/messages", token, params={"limit": _limit_param(limit, 50)})
+    cutoff = time.time() - _BULK_DELETE_MAX_AGE_SECONDS
+    ids = [m["id"] for m in messages if datetime.fromisoformat(m["timestamp"]).timestamp() > cutoff]
+    if len(ids) == 1:
+        _discord_request("DELETE", f"/channels/{channel_id}/messages/{ids[0]}", token)
+    elif ids:
+        _discord_request("POST", f"/channels/{channel_id}/messages/bulk-delete", token, body={"messages": ids})
+    return json.dumps({"success": True, "deleted": len(ids), "skipped_older_than_14_days": len(messages) - len(ids)})
+
