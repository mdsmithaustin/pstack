+++ b/poteto-mode/scripts/playbook-checklist
@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+"""Print a playbook's worklist checklist: one line per numbered step, with the
+step's identity and every skill its step and sub-bullets point at.
+
+Usage: playbook-checklist [--write] PLAYBOOK [PLAYBOOK...]
+
+--write puts the checklist under the Worklist marker at the top of each
+playbook, replacing the checklist already there.
+"""
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+MARKER = "**Worklist.** Copy these items into your worklist before step 1."
+STEP = re.compile(r"^(\d+)\.\s+(.*)")
+HEADING = re.compile(r"^\*\*([^*]+?)[.:]\*\*")
+LINK = re.compile(r"\[([^\]]*)\]\(([^)]*)\)")
+POINTER = re.compile(r"\*\*([a-z][a-z0-9-]*)\*\*|`([a-z][a-z0-9-]*)`|\]\((?:[^)]*/)?([a-z][a-z0-9-]*)/SKILL\.md\)")
+CLAUSE_END = re.compile(r"[.,;:(]\s|[.,;:(]$|\s[-–]\s|\s\(")
+SHORT_SENTENCE = 8
+
+
+def plain(text: str) -> str:
+    text = LINK.sub(r"\1", text)
+    return re.sub(r"\s+", " ", re.sub(r"[*`]", "", text)).strip()
+
+
+def without_checklist(lines: list[str]) -> list[str]:
+    """The playbook lines with the Worklist marker and its checklist removed."""
+    if MARKER not in lines:
+        return lines
+    start = lines.index(MARKER)
+    end = start + 1
+    while end < len(lines) and not lines[end].strip():
+        end += 1
+    while end < len(lines) and STEP.match(lines[end]):
+        end += 1
+    while end < len(lines) and not lines[end].strip():
+        end += 1
+    return lines[:start] + lines[end:]
+
+
+def step_blocks(text: str) -> list[list[str]]:
+    """Each top-level numbered step with the indented lines under it."""
+    blocks: list[list[str] | None] = []
+    for line in without_checklist(text.splitlines()):
+        if STEP.match(line):
+            blocks.append([line])
+        elif blocks and blocks[-1] is not None and line.startswith((" ", "\t")) and line.strip():
+            blocks[-1].append(line.strip())
+        elif blocks and line.strip():
+            blocks.append(None)
+    return [block for block in blocks if block]
+
+
+def identity(first: str, pointers: list[str]) -> str:
+    """The bold heading a step opens with, else its first sentence when that is
+    short, else its first clause."""
+    body = STEP.match(first).group(2)
+    heading = HEADING.match(body)
+    if heading:
+        return plain(heading.group(1))
+    text = plain(body)
+    sentence = re.split(r"(?<=\.)\s", text, maxsplit=1)[0].rstrip(".")
+    if len(sentence.split()) <= SHORT_SENTENCE:
+        return sentence
+    clause = CLAUSE_END.split(text + " ", maxsplit=1)[0].strip()
+    for name in pointers:
+        for spelled in (name, name.removeprefix("principle-")):
+            clause = clause.removesuffix(f" per {spelled}").removesuffix(f" per the {spelled} principle skill")
+    return clause
+
+
+def step_pointers(block: list[str], skills_root: Path) -> list[str]:
+    found: list[str] = []
+    for match in POINTER.finditer(" ".join(block)):
+        name = next(group for group in match.groups() if group)
+        for candidate in (name, f"principle-{name}"):
+            if (skills_root / candidate).is_dir():
+                if candidate not in found:
+                    found.append(candidate)
+                break
+    return found
+
+
+def checklist(text: str, skills_root: Path) -> list[str]:
+    lines = []
+    for block in step_blocks(text):
+        pointers = step_pointers(block, skills_root)
+        number = STEP.match(block[0]).group(1)
+        refs = f" ({', '.join(f'**{name}**' for name in pointers)})" if pointers else ""
+        lines.append(f"{number}. {identity(block[0], pointers)}{refs}")
+    return lines
+
+
+def written(text: str, skills_root: Path) -> str:
+    """The playbook with its checklist under the marker, after the title."""
+    lines = without_checklist(text.splitlines())
+    title = next(index for index, line in enumerate(lines) if line.startswith("#"))
+    rest = lines[title + 1:]
+    while rest and not rest[0].strip():
+        rest = rest[1:]
+    block = [MARKER, "", *checklist(text, skills_root), ""]
+    return "\n".join([*lines[:title + 1], "", *block, *rest]) + ("\n" if text.endswith("\n") else "")
+
+
+def skills_root_of(playbook: Path) -> Path:
+    return playbook.resolve().parents[2]
+
+
+def main(argv: list[str]) -> int:
+    write = "--write" in argv
+    paths = [Path(arg) for arg in argv if arg != "--write"]
+    if not paths:
+        print(__doc__.strip(), file=sys.stderr)
+        return 2
+    for path in paths:
+        text = path.read_text(encoding="utf-8")
+        root = skills_root_of(path)
+        if write:
+            path.write_text(written(text, root), encoding="utf-8")
+        else:
+            print("\n".join(checklist(text, root)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
