@@ -0,0 +1,59 @@
+"""Which family a harness belongs to.
+
+Smart Routing and host-skill discovery both group harness ids into families,
+so both read them from here and a new harness spelling is added in one place.
+"""
+
+from __future__ import annotations
+
+from typing import Literal
+
+FamilyKind = Literal["routing", "skills"]
+
+# Smart Routing model families, keyed by every spelling callers pass,
+# including the executor types ``AgentSpec.harness_kind`` returns.
+_ROUTING_FAMILIES: dict[str, str] = {
+    "claude-sdk": "claude",
+    "claude_sdk": "claude",
+    "claude-native": "claude",
+    "pi": "pi",
+    "codex": "gpt",
+    "codex-native": "gpt",
+    "openai-agents": "gpt",
+    "openai-agents-sdk": "gpt",
+    "agents_sdk": "gpt",
+}
+
+_SKILL_FAMILIES = frozenset({"claude", "codex", "cursor", "pi", "antigravity", "devin"})
+
+
+def _skill_family(harness: str) -> str | None:
+    # Every spelling of a vendor's harness shares its skill directories, so the
+    # family comes from the id: ``claude_sdk``, ``claude-native`` and
+    # ``native-claude`` all read ~/.claude.
+    normalized = harness.replace("_", "-")
+    parts = normalized.split("-")
+    base = parts[1] if parts[0] == "native" and len(parts) > 1 else parts[0]
+    # Bare ``antigravity`` is the in-process Gemini SDK executor, not the agy
+    # CLI, so it never reads ~/.gemini skills.
+    if base not in _SKILL_FAMILIES or normalized == "antigravity":
+        return None
+    return base
+
+
+def harness_family(harness: str | None, *, kind: FamilyKind = "routing") -> str | None:
+    """Return the family *harness* belongs to.
+
+    :param harness: A harness id, e.g. ``"codex-native"`` or ``"claude_sdk"``.
+        ``None``, ``""`` and the unresolved ``"auto"`` sentinel have no family.
+    :param kind: ``"routing"`` for the Smart Routing model family
+        (``"claude"``, ``"gpt"`` or ``"pi"``); ``"skills"`` for the vendor
+        whose host skill directories the harness reads (``"claude"``,
+        ``"codex"``, ``"cursor"``, ``"pi"``, ``"antigravity"`` or ``"devin"``).
+    :returns: The family, or ``None`` when the harness has none of that kind.
+    """
+    if not harness or harness == "auto":
+        return None
+    if kind == "skills":
+        return _skill_family(harness)
+    return _ROUTING_FAMILIES.get(harness)
