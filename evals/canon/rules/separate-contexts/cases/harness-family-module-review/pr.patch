@@ -0,0 +1,34 @@
+"""Tests for omnigent.harness_family."""
+
+from __future__ import annotations
+
+import pytest
+
+from omnigent.harness_family import FamilyKind, harness_family
+
+
+@pytest.mark.parametrize(
+    "harness,kind,expected",
+    [
+        ("codex-native", "routing", "gpt"),
+        ("codex-native", "skills", "codex"),
+        ("claude_sdk", "routing", "claude"),
+        ("claude_sdk", "skills", "claude"),
+        ("pi", "routing", "pi"),
+        ("pi-native", "routing", None),
+        ("pi-native", "skills", "pi"),
+        ("openai-agents", "routing", "gpt"),
+        ("openai-agents", "skills", None),
+        ("antigravity-native", "routing", None),
+        ("antigravity-native", "skills", "antigravity"),
+        ("auto", "routing", None),
+        ("auto", "skills", None),
+        (None, "skills", None),
+    ],
+)
+def test_harness_family(harness: str | None, kind: FamilyKind, expected: str | None) -> None:
+    assert harness_family(harness, kind=kind) == expected
+
+
+def test_harness_family_defaults_to_routing() -> None:
+    assert harness_family("codex") == harness_family("codex", kind="routing") == "gpt"
