diff --git a/tests/policies/builtins/features/suggested_model.feature b/tests/policies/builtins/features/suggested_model.feature
new file mode 100644
index 000000000..c4a2072c0
--- /dev/null
+++ b/tests/policies/builtins/features/suggested_model.feature
@@ -0,0 +1,37 @@
+Feature: Point trivial tasks at a suggested model
+  An operator gating expensive models can name the model trivial tasks
+  should use instead, so the agent knows where to retry after a denial.
+
+  Background:
+    Given the routing policy gates "databricks-claude-opus-4-6"
+
+  Scenario: A trivial task names the suggested model
+    Given the policy suggests "databricks-claude-haiku-4-5"
+    And the classifier rates the message trivial
+    When the agent sends "What is 2+2?" to "databricks-claude-opus-4-6"
+    Then the call is denied
+    And the reason tells the agent to use "databricks-claude-haiku-4-5"
+
+  Scenario: A cached trivial verdict still names the suggested model
+    Given the policy suggests "databricks-claude-haiku-4-5"
+    And the session already rated "What is 2+2?" trivial
+    When the agent sends "What is 2+2?" to "databricks-claude-opus-4-6"
+    Then the call is denied
+    And the reason tells the agent to use "databricks-claude-haiku-4-5"
+    And the classifier was not asked
+
+  Scenario: Without a suggestion the reason stays generic
+    Given the classifier rates the message trivial
+    When the agent sends "What is 2+2?" to "databricks-claude-opus-4-6"
+    Then the call is denied
+    And the reason tells the agent to use a smaller model
+
+  Scenario: A complex task is allowed whatever the suggestion
+    Given the policy suggests "databricks-claude-haiku-4-5"
+    And the classifier rates the message complex
+    When the agent sends "Refactor the billing module" to "databricks-claude-opus-4-6"
+    Then the call is allowed
+
+  Scenario: A gated model cannot be the suggestion
+    When the policy is configured to suggest "databricks-claude-opus-4-6"
+    Then configuration fails naming "databricks-claude-opus-4-6"
diff --git a/tests/policies/builtins/test_suggested_model_scenarios.py b/tests/policies/builtins/test_suggested_model_scenarios.py
new file mode 100644
index 000000000..f9242970e
--- /dev/null
+++ b/tests/policies/builtins/test_suggested_model_scenarios.py
@@ -0,0 +1,113 @@
+"""
+Step definitions for ``features/suggested_model.feature``.
+
+Drives :func:`omnigent.policies.builtins.routing.deny_trivial_to_expensive_model`
+with a stub classifier and checks the verdict the agent would see.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+from pytest_bdd import given, parsers, scenarios, then, when
+
+from omnigent.policies.builtins.routing import (
+    _CACHE_KEY_PREFIX,
+    deny_trivial_to_expensive_model,
+)
+
+from .helpers import llm_request_event
+
+scenarios("features/suggested_model.feature")
+
+
+class _StubResponse:
+    """Classifier response exposing ``output_text`` like the SDK ``Response``."""
+
+    def __init__(self, output_text: str) -> None:
+        self.output_text = output_text
+
+
+@pytest.fixture
+def routing() -> dict[str, Any]:
+    """Mutable state shared by the steps of one scenario."""
+    return {"suggested_model": None, "session_state": {}, "classifier": AsyncMock()}
+
+
+@given(parsers.parse('the routing policy gates "{model}"'))
+def gated_model(routing: dict[str, Any], model: str) -> None:
+    routing["expensive_models"] = [model]
+
+
+@given(parsers.parse('the policy suggests "{model}"'))
+def suggestion(routing: dict[str, Any], model: str) -> None:
+    routing["suggested_model"] = model
+
+
+@given(parsers.parse("the classifier rates the message {difficulty}"))
+def classifier_rating(routing: dict[str, Any], difficulty: str) -> None:
+    body = json.dumps({"difficulty": difficulty.upper()})
+    routing["classifier"].return_value = _StubResponse(body)
+
+
+@given(parsers.parse('the session already rated "{message}" {difficulty}'))
+def cached_rating(routing: dict[str, Any], message: str, difficulty: str) -> None:
+    digest = hashlib.sha256(message.encode()).hexdigest()[:16]
+    routing["session_state"][f"{_CACHE_KEY_PREFIX}{digest}"] = difficulty.upper()
+
+
+@when(parsers.parse('the agent sends "{message}" to "{model}"'))
+def send(routing: dict[str, Any], message: str, model: str) -> None:
+    policy = deny_trivial_to_expensive_model(
+        expensive_models=routing["expensive_models"],
+        suggested_model=routing["suggested_model"],
+    )
+    event = llm_request_event(model=model, last_user_message=message)
+    event["session_state"] = routing["session_state"]
+    event["llm_client"] = type("_Client", (), {"create": routing["classifier"]})()
+    routing["verdict"] = asyncio.run(policy(event))
+
+
+@when(parsers.parse('the policy is configured to suggest "{model}"'))
+def configure_gated_suggestion(routing: dict[str, Any], model: str) -> None:
+    with pytest.raises(ValueError) as excinfo:
+        deny_trivial_to_expensive_model(
+            expensive_models=routing["expensive_models"],
+            suggested_model=model,
+        )
+    routing["error"] = str(excinfo.value)
+
+
+@then("the call is denied")
+def denied(routing: dict[str, Any]) -> None:
+    assert routing["verdict"]["result"] == "DENY"
+
+
+@then("the call is allowed")
+def allowed(routing: dict[str, Any]) -> None:
+    assert routing["verdict"]["result"] == "ALLOW"
+
+
+@then(parsers.parse('the reason tells the agent to use "{model}"'))
+def reason_names_model(routing: dict[str, Any], model: str) -> None:
+    assert f"Use '{model}' for simple tasks." in routing["verdict"]["reason"]
+
+
+@then("the reason tells the agent to use a smaller model")
+def reason_is_generic(routing: dict[str, Any]) -> None:
+    assert "Use a smaller model for simple tasks." in routing["verdict"]["reason"]
+
+
+@then("the classifier was not asked")
+def classifier_not_asked(routing: dict[str, Any]) -> None:
+    routing["classifier"].assert_not_awaited()
+
+
+@then(parsers.parse('configuration fails naming "{model}"'))
+def configuration_fails(routing: dict[str, Any], model: str) -> None:
+    assert model in routing["error"]
