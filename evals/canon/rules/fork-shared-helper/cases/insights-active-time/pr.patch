From c288557bec5b569c778f8369af81fcbb210d32f6 Mon Sep 17 00:00:00 2001
From: Tomasz Wierzbicki <tomasz.wierzbicki@example.com>
Date: Fri, 25 Sep 2026 17:13:54 -0600
Subject: [PATCH] feat(insights): show active time per platform

The Platforms table in /insights counted sessions, messages and tokens
but not time, so a gateway user could not see where their hours went.
Each platform row now carries active_seconds (summed ended-session
length, same drift guard as the overview) and both the terminal table
and the gateway summary render it.

Summed active time across 30 days routinely passes a day, and the
compact duration used to switch to fractional days there ("2.2d"),
which reads like calendar days. Durations now keep counting in hours
("52h 10m").
---
 agent/insights.py            | 30 +++++++++++++++++++++++-------
 agent/usage_pricing.py       |  9 ++++-----
 tests/agent/test_insights.py | 28 ++++++++++++++++++++++++++++
 3 files changed, 55 insertions(+), 12 deletions(-)

diff --git a/agent/insights.py b/agent/insights.py
index 53ac36a7c9..1dbd282ed1 100644
--- a/agent/insights.py
+++ b/agent/insights.py
@@ -76,6 +76,18 @@ def _day(ts: Any) -> str:
     return safe_strftime(datetime.fromtimestamp(ts), "%b %d") if ts and (ts := coerce_epoch(ts)) else "?"
 
 
+def _active_seconds(session: Dict[str, Any]) -> float:
+    """Wall-clock length of an ended session; 0 when a timestamp is missing or the clock drifted
+    backwards (ended before it started)."""
+    started, ended = session.get("started_at"), session.get("ended_at")
+    return ended - started if started and ended and ended > started else 0.0
+
+
+def _active_label(platform_row: Dict[str, Any]) -> str:
+    """``3h 15m`` for a platform row's summed session time; ``—`` when none of its sessions ended."""
+    return format_duration_compact(platform_row["active_seconds"]) if platform_row["active_seconds"] else "—"
+
+
 def _scoped(before: str, after: str = "", *, src: str = " AND s.source = ?") -> tuple[str, str]:
     """(unfiltered, source-filtered) query pair sharing one body. Built once at class definition,
     so no runtime value can alter query structure."""
