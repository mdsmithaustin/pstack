+
     def test_skill_breakdown(self, populated_db):
         engine = InsightsEngine(populated_db)
         report = engine.generate(days=30)
@@ -509,6 +520,23 @@ class TestGatewayFormatting:
 
         assert len(gateway_text) < len(terminal_text)
 
+    def test_platform_lines_show_active_time_on_both_surfaces(self, db):
+        now = time.time()
+        for sid, source, hours in (("tg", "telegram", 30), ("cli1", "cli", 2)):
+            db.create_session(session_id=sid, source=source, model="test")
+            db.end_session(sid, end_reason="user_exit")
+            db._conn.execute("UPDATE sessions SET started_at = ?, ended_at = ? WHERE id = ?",
+                             (now - 2 * 86400, now - 2 * 86400 + hours * 3600, sid))
+        db._conn.commit()
+
+        engine = InsightsEngine(db)
+        report = engine.generate(days=30)
+        terminal_line = next(line for line in engine.format_terminal(report).splitlines() if line.strip().startswith("telegram"))
+        gateway_line = next(line for line in engine.format_gateway(report).splitlines() if line.strip().startswith("telegram"))
+
+        assert terminal_line.rstrip().endswith("30h")
+        assert gateway_line.endswith("~30h active")
+
 
 
 
