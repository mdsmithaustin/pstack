         # the whole lint run.
         pass
     return disabled
+
+
+def report_file_hits(argv: list[str], scan: Callable[[Path], list[tuple[int, str]]], label: str, footer: str) -> int:
+    """Scan every file in ``argv[1:]``, write ``path:line: <label><detail>`` per hit, then ``footer`` once.
+
+    :returns: Exit code -- 0 on a clean scan, 1 if any hits.
+    """
+    failed = False
+    for arg in argv[1:]:
+        path = Path(arg)
+        if not path.is_file():
+            continue
+        for line, detail in scan(path):
+            failed = True
+            sys.stdout.write(f"{path}:{line}: {label}{detail}\n")
+    if failed:
+        sys.stdout.write(footer)
+        return 1
+    return 0
