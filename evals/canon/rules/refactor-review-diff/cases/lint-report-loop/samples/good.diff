 import io
 import re
+import sys
 import tokenize
+from collections.abc import Callable
+from pathlib import Path
 
 _DISABLE_RE = re.compile(r"custom-lint:\s*disable(-next)?=([a-z0-9-]+(?:\s*,\s*[a-z0-9-]+)*)")
 # Cheap pre-screen so files with no markers skip tokenization entirely.
@@ -49,3 +52,30 @@ def disabled_rules_by_line(source: str) -> dict[int, set[str]]:
         # the whole lint run.
         pass
     return disabled
+
+
+def report_file_hits(
+    argv: list[str],
+    scan: Callable[[Path], list[tuple[int, str]]],
+    format_hit: Callable[[Path, int, str], str],
+    footer: str,
+) -> int:
+    """Scan every file in ``argv[1:]``, write each hit, then ``footer`` once.
+
+    Arguments that are not files are skipped. ``format_hit`` returns the full
+    text written for one hit, trailing newline included.
+
+    :returns: Exit code -- 0 on a clean scan, 1 if any hits.
+    """
+    failed = False
+    for arg in argv[1:]:
+        path = Path(arg)
+        if not path.is_file():
+            continue
+        for line, detail in scan(path):
+            failed = True
+            sys.stdout.write(format_hit(path, line, detail))
+    if failed:
+        sys.stdout.write(footer)
+        return 1
+    return 0
