+++ b/omnigent/harness_names.py
@@ -0,0 +1,37 @@
+"""One entry point for harness-name questions."""
+
+from __future__ import annotations
+
+from typing import Protocol
+
+from omnigent import gateway_inference, harness_aliases, harness_availability
+
+
+class HarnessNameResolver(Protocol):
+    """Answers every harness-name question callers ask."""
+
+    def canonical(self, harness: str | None) -> str | None: ...
+
+    def is_native(self, harness: str | None) -> bool: ...
+
+    def spellings(self, family: str) -> tuple[str, ...]: ...
+
+
+class RegistryHarnessNameResolver:
+    """Resolves names through the plugin registry."""
+
+    def canonical(self, harness: str | None) -> str | None:
+        return harness_aliases.canonicalize_harness(harness)
+
+    def is_native(self, harness: str | None) -> bool:
+        return harness_aliases.is_native_harness(harness)
+
+    def spellings(self, family: str) -> tuple[str, ...]:
+        if family == "codex":
+            return tuple(sorted(harness_availability.CODEX_CANONICAL_HARNESSES))
+        if family == "claude":
+            return gateway_inference.CLAUDE_GATEWAY_HARNESSES
+        return (family,)
+
+
+resolver: HarnessNameResolver = RegistryHarnessNameResolver()
