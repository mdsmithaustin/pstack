diff --git a/omnigent/harness_aliases.py b/omnigent/harness_aliases.py
index c261da7..b40fe9f 100644
--- a/omnigent/harness_aliases.py
+++ b/omnigent/harness_aliases.py
@@ -77,3 +77,20 @@ def native_terminal_name(harness: str | None) -> str | None:
     # reversed ``native-<name>`` spelling (not all are folded by
     # ``canonicalize_harness``), so strip either affix.
     return canonical.removesuffix("-native").removeprefix("native-")
+
+
+def native_spellings(terminal: str) -> frozenset[str]:
+    """Return every native harness spelling whose CLI runs in *terminal*.
+
+    Derived from the registry, e.g. ``"codex"`` ->
+    ``{"codex-native", "native-codex"}``.
+
+    :param terminal: A terminal short-name, e.g. ``"claude"``.
+    :returns: The native spellings, empty when none runs there.
+    """
+    return frozenset(name for name in NATIVE_HARNESSES if native_terminal_name(name) == terminal)
+
+
+# The Codex family: the exec harness plus its native spellings. Readiness,
+# model-override, and gateway checks must agree on every one.
+CODEX_HARNESSES: frozenset[str] = frozenset({"codex"}) | native_spellings("codex")
