+++ b/omnigent/harness_terminals.py
@@ -0,0 +1,27 @@
+"""Where native harness terminal names come from."""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+
+from omnigent.harness_plugins import native_agents
+
+
+class TerminalNameSource(ABC):
+    """Maps a canonical native harness id to its terminal short-name."""
+
+    @abstractmethod
+    def terminal_name(self, canonical: str) -> str | None: ...
+
+
+class RegistryTerminalNames(TerminalNameSource):
+    """Reads terminal names from the native coding-agent rows."""
+
+    def terminal_name(self, canonical: str) -> str | None:
+        for agent in native_agents():
+            if canonical in (agent.harness, f"native-{agent.terminal_name}"):
+                return agent.terminal_name
+        return None
+
+
+TERMINAL_NAMES: TerminalNameSource = RegistryTerminalNames()
