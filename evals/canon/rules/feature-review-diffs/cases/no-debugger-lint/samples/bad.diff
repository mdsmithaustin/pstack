diff --git a/dev/lint/lint_no_debugger.py b/dev/lint/lint_no_debugger.py
new file mode 100644
index 0000000..e41db91
--- /dev/null
+++ b/dev/lint/lint_no_debugger.py
@@ -0,0 +1,54 @@
+"""Flag debugger calls and imports left in committed Python.
+
+Catches ``breakpoint()``, ``<debugger>.set_trace()``, and ``import <debugger>`` /
+``from <debugger> import ...`` for pdb, ipdb, and pudb. Detection is a line scan.
+"""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+RULE_NAME = "no-debugger"
+HINT = "Remove the debugger call or import before committing."
+SCANNED_ROOTS = ("omnigent/", "tests/", "dev/")
+
+
+_PATTERN = re.compile(r"breakpoint\(\)|\b(?:pdb|ipdb|pudb)\.set_trace\(|^\s*(?:import|from)\s+(?:pdb|ipdb|pudb)\b")
+
+
+def scan(path: Path) -> list[tuple[int, str]]:
+    """``[(line, text), ...]`` for each line in ``path`` that calls or imports a debugger."""
+    try:
+        lines = path.read_text().splitlines()
+    except (OSError, UnicodeDecodeError):
+        return []
+    return [(number, line.strip()) for number, line in enumerate(lines, 1) if _PATTERN.search(line)]
+
+
+def _messages(paths: list[Path]) -> list[str]:
+    return [f"{path.as_posix()}:{line}: debugger left in code: {what}" for path in paths for line, what in scan(path)]
+
+
+def check() -> list[str]:
+    """Rule entry point for the custom-lint runner: every tracked .py under the scanned roots."""
+    output = subprocess.check_output(["git", "ls-files", "-z", *SCANNED_ROOTS])
+    return _messages([Path(raw) for raw in output.decode().split("\0") if raw.endswith(".py")])
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Scan the given files, or the full surface when none are given."""
+    args = (argv if argv is not None else sys.argv)[1:]
+    messages = _messages([Path(arg) for arg in args if Path(arg).is_file()]) if args else check()
+    if not messages:
+        return 0
+    for message in messages:
+        sys.stdout.write(f"{message}\n")
+    sys.stdout.write(f"\n{HINT}\n")
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/dev/lint/test_lint_no_debugger.py b/tests/dev/lint/test_lint_no_debugger.py
