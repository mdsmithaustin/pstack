index 0000000..abe273b
--- /dev/null
+++ b/tests/dev/lint/test_lint_no_debugger.py
@@ -0,0 +1,27 @@
+"""Tests for the no-debugger custom lint rule (``dev/lint/lint_no_debugger.py``)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import dev.lint.custom_lint as custom_lint
+from dev.lint.lint_no_debugger import main, scan
+
+
+def test_scan_flags_calls_and_imports(tmp_path: Path) -> None:
+    f = tmp_path / "mod.py"
+    f.write_text("import pdb\nbreakpoint()\npdb.set_trace()\nfrom ipdb import set_trace\n")
+    assert [line for line, _ in scan(f)] == [1, 2, 3, 4]
+
+
+def test_main_exit_codes(tmp_path: Path) -> None:
+    dirty = tmp_path / "dirty.py"
+    dirty.write_text("breakpoint()\n")
+    clean = tmp_path / "clean.py"
+    clean.write_text("x = 1\n")
+    assert main(["lint_no_debugger.py", str(dirty)]) == 1
+    assert main(["lint_no_debugger.py", str(clean)]) == 0
+
+
+def test_registered_with_the_runner() -> None:
+    assert any(rule.name == "no-debugger" for rule in custom_lint.RULES)
