@@ -0,0 +1,60 @@
+"""/topup → Monthly limit: an admin changes the org's monthly spend cap from the terminal."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+
+import hermes_cli.nous_billing as nb
+from agent.billing_view import BillingState, MonthlyCap
+from hermes_cli.cli_billing_mixin import CLIBillingMixin
+
+
+class _Host(CLIBillingMixin):
+    """The mixin with the terminal I/O replaced by scripted answers."""
+
+    def __init__(self, answers):
+        self._app = object()
+        self._answers = list(answers)
+        self.lines: list[str] = []
+
+    def _block_header(self, icon, title, *, rule=True):
+        self.lines.append(title)
+
+    def _dim(self, msg, *, icon="", lead=False):
+        self.lines.append(msg)
+
+    def _modal_choice(self, title, detail, choices):
+        return self._answers.pop(0)
+
+    def _prompt_text_input(self, prompt):
+        return self._answers.pop(0)
+
+
+def _admin_state() -> BillingState:
+    return BillingState(
+        logged_in=True, role="OWNER", cli_billing_enabled=True,
+        monthly_cap=MonthlyCap(limit_usd=Decimal("1000"), spent_this_month_usd=Decimal("180"),
+                               is_default_ceiling=True, ceiling_usd=Decimal("1000")))
+
+
+@pytest.fixture
+def puts(monkeypatch):
+    sent: list[dict] = []
+    monkeypatch.setattr(nb, "put_monthly_cap", lambda **kw: sent.append(kw) or {})
+    return sent
+
+
+def test_admin_lowers_the_monthly_limit(puts, capsys):
+    _Host(["change", "750"])._billing_limit_screen(_admin_state())
+
+    assert puts == [{"limit_usd": 750.0}]
+    assert "Monthly limit set to $750." in capsys.readouterr().out
+
+
+def test_limit_above_the_ceiling_is_refused_before_any_request(puts, capsys):
+    _Host(["change", "1500"])._billing_limit_screen(_admin_state())
+
+    assert puts == []
+    assert "$1000 ceiling" in capsys.readouterr().out
