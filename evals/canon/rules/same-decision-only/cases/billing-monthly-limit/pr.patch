 @_dict_parser
@@ -362,3 +363,21 @@ def validate_charge_amount(raw: str, *, min_usd: Optional[Decimal], max_usd: Opt
     else:
         return AmountValidation(ok=True, amount=amount)
     return AmountValidation(ok=False, error=error)
+
+
+def validate_monthly_limit(raw: str, *, ceiling_usd: Optional[Decimal]) -> AmountValidation:
+    """Mirror ``PUT /api/billing/monthly-cap``'s accept/reject (``limitUsd`` > 0, multipleOf 0.01, at most
+    the org's ``ceilingUsd``) for instant UI feedback; server is authoritative. The limit caps what the
+    org can spend in a month; nothing is charged, so the charge bounds (``bounds.minUsd``) don't apply."""
+    limit = parse_money((raw or "").strip().lstrip("$").strip())
+    if limit is None:
+        error = "Enter a dollar amount, e.g. 500"
+    elif limit <= 0:
+        error = "Limit must be greater than $0"
+    elif limit != limit.quantize(Decimal("0.01")):
+        error = "Limit can't be smaller than a cent"
+    elif ceiling_usd is not None and limit > ceiling_usd:
+        error = f"Limit can't be above your org's {format_money(ceiling_usd)} ceiling"
+    else:
+        return AmountValidation(ok=True, amount=limit)
+    return AmountValidation(ok=False, error=error)
