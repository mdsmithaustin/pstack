+def _strip_grouping(tokens: list[str]) -> list[str]:
+    """
+    Drop the subshell and brace-group punctuation around one segment's command.
+
+    Segments are split only on chaining operators, so ``( git push … )`` and
+    ``{ git push …; }`` reach the policies with ``(`` or ``{`` as the apparent
+    command. Stripping the punctuation here, rather than splitting on it, keeps
+    brace expansion such as ``main{,}`` inside its token.
+
+    :param tokens: shlex-split tokens of one segment, e.g.
+        ``["(git", "push", "origin", "main)"]``.
+    :returns: The tokens without the grouping punctuation, e.g.
+        ``["git", "push", "origin", "main"]``.
+    """
+    tokens = list(tokens)
+    while tokens and tokens[0] in ("(", "{"):
+        tokens.pop(0)
+    if tokens and tokens[0].startswith("("):
+        tokens[0] = tokens[0].lstrip("(")
+    while tokens and tokens[-1] in (")", "}"):
+        tokens.pop()
+    if tokens and tokens[-1].endswith(")"):
+        tokens[-1] = tokens[-1].rstrip(")")
+    return [token for token in tokens if token]
+
+
