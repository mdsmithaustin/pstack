--- a/tests/policies/builtins/test_safety_pii.py
+++ b/tests/policies/builtins/test_safety_pii.py
@@ -363,3 +363,19 @@ def test_allows_clean_request_dict() -> None:
         [{"filename": "notes.txt", "content_type": "text/plain", "text": "no pii here"}],
     )
     assert policy(event)["result"] == "ALLOW"
+
+
+def test_denies_ipv4_address_in_system_prompt() -> None:
+    """An IPv4 address in the system prompt triggers DENY."""
+    policy = deny_pii_in_llm_request()
+    event = llm_request_event(system_prompt_preview="The database lives at 10.20.30.40.")
+    result = policy(event)
+    assert result["result"] == "DENY"
+    assert "ip address" in result["reason"].lower()
+
+
+def test_ipv4_category_can_be_selected_alone() -> None:
+    """Selecting only ``ip_address`` ignores other categories."""
+    policy = deny_pii_in_llm_request(pii_types=["ip_address"])
+    assert policy(llm_request_event(system_prompt_preview="Mail bob@example.com"))["result"] == "ALLOW"
+    assert policy(llm_request_event(system_prompt_preview="Host 192.168.0.1"))["result"] == "DENY"
