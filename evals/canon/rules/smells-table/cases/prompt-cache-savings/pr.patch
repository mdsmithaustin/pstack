diff --git a/tests/agent/test_cache_savings.py b/tests/agent/test_cache_savings.py
new file mode 100644
index 0000000000..8c8633dbaf
--- /dev/null
+++ b/tests/agent/test_cache_savings.py
@@ -0,0 +1,67 @@
+"""Prompt-cache savings: reads saved against the full input rate, net of the write premium."""
+from decimal import Decimal
+from types import SimpleNamespace
+
+from agent import cache_savings
+from agent.cache_savings import cache_savings_usd, estimate_cache_savings, format_cache_line
+from agent.usage_pricing import PricingEntry
+
+# $3 input, $0.30 cache read, $3.75 cache write per million (Sonnet-shaped rates).
+_ENTRY = PricingEntry(
+    input_cost_per_million=Decimal("3.00"), output_cost_per_million=Decimal("15.00"),
+    cache_read_cost_per_million=Decimal("0.30"), cache_write_cost_per_million=Decimal("3.75"),
+    source="official_docs_snapshot",
+)
+
+
+def test_reads_save_the_rate_gap_and_writes_cost_the_premium():
+    # 100k reads save 100k * $2.70/M; 10k writes cost 10k * $0.75/M extra.
+    assert cache_savings_usd(_ENTRY, 120_000, 100_000, 10_000) == Decimal("0.27") - Decimal("0.0075")
+    # A write-only first call is a net cost, and the label says so.
+    first_call = cache_savings_usd(_ENTRY, 50_000, 0, 50_000)
+    assert first_call == Decimal("-0.0375")
+    assert format_cache_line(50_000, 0, 50_000, first_call) == "0/50,000 tokens (0% hit, 50,000 written, cost ~$0.04 extra)"
+
+
+def test_tiered_rates_apply_to_the_whole_request_above_the_threshold():
+    tiered = PricingEntry(
+        input_cost_per_million=Decimal("1.25"), cache_read_cost_per_million=Decimal("0.125"),
+        cache_write_cost_per_million=Decimal("1.25"), tier_threshold_tokens=200_000,
+        input_cost_per_million_above=Decimal("2.50"), cache_read_cost_per_million_above=Decimal("0.25"),
+        source="official_docs_snapshot",
+    )
+    below = cache_savings_usd(tiered, 200_000, 100_000, 0)
+    above = cache_savings_usd(tiered, 200_001, 100_000, 0)
+    assert above == 2 * below
+
+
+def test_unknown_or_included_pricing_reports_nothing():
+    no_read_rate = PricingEntry(input_cost_per_million=Decimal("3.00"), source="provider_models_api")
+    assert cache_savings_usd(no_read_rate, 10_000, 5_000, 0) is None
+    assert estimate_cache_savings("gpt-5.6-sol", 10_000, 5_000, 0, provider="openai-codex") is None
+    assert estimate_cache_savings("claude-sonnet-4-6", 10_000, 0, 0, provider="anthropic") is None
+
+
+def test_session_accumulates_savings_and_a_new_session_clears_them(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(cache_savings, "get_pricing_entry", lambda *a, **k: _ENTRY)
+    from agent import turn_usage
+    from run_agent import AIAgent
+
+    agent = AIAgent(api_key="k", base_url="https://inference-api.nousresearch.com/v1", provider="nous",
+                    api_mode="chat_completions", model="anthropic/claude-sonnet-4.6", session_id="t", platform="cli",
+                    quiet_mode=True, skip_context_files=True, skip_memory=True, save_trajectories=False,
+                    enabled_toolsets=["file"])
+    usage = SimpleNamespace(prompt_tokens=120_000, completion_tokens=7, total_tokens=120_007,
+                            prompt_tokens_details=SimpleNamespace(cached_tokens=100_000, cache_write_tokens=10_000),
+                            completion_tokens_details=None)
+    try:
+        for n in (1, 2):
+            turn_usage.record_response_usage(agent, SimpleNamespace(usage=usage, id=None, model=agent.model),
+                                             messages=[{"role": "user", "content": "hi"}], api_call_count=n,
+                                             api_duration=0.1, compression_attempts=0, max_compression_attempts=3)
+        assert agent.session_cache_savings_usd == float(2 * cache_savings_usd(_ENTRY, 120_000, 100_000, 10_000))
+        agent.reset_session_state()
+        assert agent.session_cache_savings_usd == 0.0
+    finally:
+        agent.close()
