+++ b/agent/cache_savings.py
@@ -0,0 +1,77 @@
+"""Prompt-cache savings: what cache reads saved against paying the full input rate.
+
+A cache read bills at a fraction of the input rate, and a cache write bills at a
+premium over it (1.25x input on Anthropic and OpenAI GPT-5.6). The net figure is
+``reads * (input - read) - writes * (write - input)`` per million tokens, so the
+first call of a conversation, which only writes, usually shows a small cost and
+later calls that hit the cache show the saving.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+from typing import Optional
+
+from agent.usage_pricing import PricingEntry, format_cost_label, get_pricing_entry
+
+_ONE_MILLION = Decimal("1000000")
+
+
+def cache_savings_usd(
+    entry: PricingEntry, prompt_tokens: int, cache_read_tokens: int, cache_write_tokens: int,
+) -> Optional[Decimal]:
+    """Net USD saved by the cache for one request, or None when a needed rate is unknown.
+
+    Above ``tier_threshold_tokens`` the ``*_above`` rates apply to the whole request,
+    matching how ``estimate_usage_cost`` prices it.
+    """
+    above = entry.tier_threshold_tokens is not None and prompt_tokens > entry.tier_threshold_tokens
+
+    def rate(base: Optional[Decimal], above_rate: Optional[Decimal]) -> Optional[Decimal]:
+        return above_rate if above and above_rate is not None else base
+
+    input_rate = rate(entry.input_cost_per_million, entry.input_cost_per_million_above)
+    read_rate = rate(entry.cache_read_cost_per_million, entry.cache_read_cost_per_million_above)
+    write_rate = rate(entry.cache_write_cost_per_million, entry.cache_write_cost_per_million_above)
+    if input_rate is None:
+        return None
+    if (cache_read_tokens and read_rate is None) or (cache_write_tokens and write_rate is None):
+        return None
+    saved = Decimal(cache_read_tokens) * (input_rate - read_rate) if cache_read_tokens else Decimal(0)
+    premium = Decimal(cache_write_tokens) * (write_rate - input_rate) if cache_write_tokens else Decimal(0)
+    return (saved - premium) / _ONE_MILLION
+
+
+def estimate_cache_savings(
+    model: str, prompt_tokens: int, cache_read_tokens: int, cache_write_tokens: int, *,
+    provider: Optional[str] = None, base_url: Optional[str] = None, api_key: Optional[str] = None,
+) -> Optional[Decimal]:
+    """Cache savings for one request on this route; None when there is nothing to price.
+
+    Subscription-included routes carry no per-token price, so they report None rather
+    than a misleading $0.00.
+    """
+    if not (cache_read_tokens or cache_write_tokens):
+        return None
+    entry = get_pricing_entry(model, provider=provider, base_url=base_url, api_key=api_key)
+    if entry is None or entry.source == "none":
+        return None
+    return cache_savings_usd(entry, prompt_tokens, cache_read_tokens, cache_write_tokens)
+
+
+def format_savings_label(savings: Decimal) -> str:
+    """``saved ~$0.12`` for a net saving, ``cost ~$0.01 extra`` when writes outweigh reads."""
+    if savings < 0:
+        return f"cost {format_cost_label(-savings)} extra"
+    return f"saved {format_cost_label(savings)}"
+
+
+def format_cache_line(
+    prompt_tokens: int, cache_read_tokens: int, cache_write_tokens: int, savings: Optional[Decimal],
+) -> str:
+    """The body of the per-call ``💾 Cache:`` line."""
+    hit_pct = (cache_read_tokens / prompt_tokens * 100) if prompt_tokens > 0 else 0
+    line = f"{cache_read_tokens:,}/{prompt_tokens:,} tokens ({hit_pct:.0f}% hit, {cache_write_tokens:,} written"
+    if savings is not None:
+        line += f", {format_savings_label(savings)}"
+    return line + ")"
