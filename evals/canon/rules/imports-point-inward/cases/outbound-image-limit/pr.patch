From 79cfdcb3679be3fd2d72cf289520890862f60c92 Mon Sep 17 00:00:00 2001
From: Tomasz Wieczorek <tomasz.wieczorek@example.com>
Date: Fri, 25 Sep 2026 17:03:05 -0600
Subject: [PATCH 1/2] feat(agent): configurable outbound image ceiling for
 send-path eviction

The send-path eviction retires old tool-result screenshots once a request would carry more
than 20 images or 24 MB of image bytes. 20 is Anthropic's stricter-dimension threshold, so
on Gemini and OpenAI a long computer-use session loses frames it could have kept.

Add vision.outbound_image_limit (clamped 4..100) and vision.outbound_image_budget_mb
(clamped 1..30). The policy resolves them when a caller does not pass limit/budget, so the
OpenAI-shaped pass and the Anthropic wire pass keep agreeing on one frontier (#113517).
---
 agent/image_eviction_policy.py            | 63 +++++++++++++++++++--
 hermes_cli/config_defaults.py             |  6 ++
 tests/agent/test_image_eviction_policy.py | 69 +++++++++++++++++++++++
 3 files changed, 134 insertions(+), 4 deletions(-)

diff --git a/agent/image_eviction_policy.py b/agent/image_eviction_policy.py
index cde689d3d1..0dafede5b1 100644
--- a/agent/image_eviction_policy.py
+++ b/agent/image_eviction_policy.py
@@ -17,11 +17,16 @@ retiring a batch costs one slower turn per batch and nothing below the limit.
 (2000 px) to EVERY image in the request, counting images nested in tool_result content. The hard
 ceilings are higher (100 images per request on 200K-context models, 600 otherwise) but the 32 MB
 request-size limit usually binds first, which the byte budget guards with headroom for text.
+
+Sessions that never hit Anthropic's dimension cap (Gemini, OpenAI, small screenshots) can raise
+both ceilings with ``vision.outbound_image_limit`` and ``vision.outbound_image_budget_mb``. The
+configured values are resolved here, inside the shared policy, so the two passes cannot disagree
+on the frontier.
 """
 
 from __future__ import annotations
 
-from typing import Optional, Sequence
+from typing import Any, Optional, Sequence
 
 OUTBOUND_IMAGE_LIMIT = 20
 OUTBOUND_IMAGE_BUDGET_BYTES = 24_000_000
@@ -29,6 +34,51 @@ IMAGE_EVICTION_BATCH = 8
 # Satisfiability floor — see outbound_image_retire_count.
 OUTBOUND_IMAGE_FLOOR = 3
 
+# Anthropic's hard per-request ceiling on 200K-context models; a configured limit above it 400s.
+_MAX_OUTBOUND_IMAGE_LIMIT = 100
+# The request-size limit is 32 MB; keep 2 MB of it for text and tool schemas.
+_MAX_OUTBOUND_IMAGE_BUDGET_BYTES = 30_000_000
+
+
+def _cfg_vision(key: str, default: Any = None) -> Any:
+    """``vision.<key>`` from config.yaml; ``default`` when config is unavailable."""
+    try:
+        from hermes_cli.config import cfg_get, load_config
+        return cfg_get(load_config(), "vision", key, default=default)
+    except Exception:
+        return default
+
+
+def _configured_int(raw: Any, default: int, low: int, high: int) -> int:
+    try:
+        if raw is None or isinstance(raw, bool):
+            raise ValueError("not a number")
+        value = int(raw)
+    except (TypeError, ValueError, OverflowError):
+        return default
+    return min(max(value, low), high)
+
+
+def resolve_outbound_image_limit() -> int:
+    """``vision.outbound_image_limit`` clamped to floor+1..100; 20 when unset or unparseable."""
+    return _configured_int(
+        _cfg_vision("outbound_image_limit"),
+        OUTBOUND_IMAGE_LIMIT,
+        OUTBOUND_IMAGE_FLOOR + 1,
+        _MAX_OUTBOUND_IMAGE_LIMIT,
+    )
+
+
+def resolve_outbound_image_budget_bytes() -> int:
+    """``vision.outbound_image_budget_mb`` in bytes, clamped to 1..30 MB; 24 MB when unset."""
+    megabytes = _configured_int(
+        _cfg_vision("outbound_image_budget_mb"),
+        OUTBOUND_IMAGE_BUDGET_BYTES // 1_000_000,
+        1,
+        _MAX_OUTBOUND_IMAGE_BUDGET_BYTES // 1_000_000,
+    )
+    return megabytes * 1_000_000
+
 
 def outbound_image_retire_count(
     carrier_blocks_newest_first: Sequence[int],
@@ -36,8 +86,8 @@ def outbound_image_retire_count(
     *,
     carrier_bytes_newest_first: Optional[Sequence[int]] = None,
     reserved_bytes: int = 0,
-    limit: int = OUTBOUND_IMAGE_LIMIT,
-    budget: int = OUTBOUND_IMAGE_BUDGET_BYTES,
+    limit: Optional[int] = None,
+    budget: Optional[int] = None,
     batch: int = IMAGE_EVICTION_BATCH,
     floor: int = OUTBOUND_IMAGE_FLOOR,
 ) -> int:
@@ -46,7 +96,8 @@ def outbound_image_retire_count(
     ``carrier_blocks_newest_first`` is the image-block count per image-bearing tool result,
     newest first; ``reserved_blocks`` counts images the pass must never rewrite (user
     uploads). The byte dimension is active only when ``carrier_bytes_newest_first`` is
-    given (the wire pass has no sizes).
+    given (the wire pass has no sizes). ``limit`` and ``budget`` default to the configured
+    ceilings (:func:`resolve_outbound_image_limit`, :func:`resolve_outbound_image_budget_bytes`).
 
     The retire count must be a STEP FUNCTION of the overshoot, because the pass is recomputed
     on every request: an exact ``count - limit`` target moves the frontier on every new image,
@@ -66,6 +117,10 @@ def outbound_image_retire_count(
     """
     total = len(carrier_blocks_newest_first)
     sizes = carrier_bytes_newest_first
+    if limit is None:
+        limit = resolve_outbound_image_limit()
+    if budget is None and sizes is not None:
+        budget = resolve_outbound_image_budget_bytes()
     blocks_kept = [0] * (total + 1)
     bytes_kept = [0] * (total + 1)
     for i in range(total):
diff --git a/hermes_cli/config_defaults.py b/hermes_cli/config_defaults.py
index 7e1bed1cd1..cf76cc0ecb 100644
--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -1231,6 +1231,12 @@ DEFAULT_CONFIG = {
         # null = 3 inside delegated subagents (they run unattended), unlimited for the main agent;
         # an explicit number applies everywhere; 0 = unlimited.
         "max_calls_per_image": None,
+        # Images one request may carry before the oldest tool-result screenshots are retired in
+        # batches (clamped 4..100). 20 is Anthropic's stricter-dimension threshold; raise it on
+        # providers without that cap so long computer-use sessions keep more frames.
+        "outbound_image_limit": 20,
+        # Image bytes one request may carry (clamped 1..30 MB) before the same retirement kicks in.
+        "outbound_image_budget_mb": 24,
     },
     # "Hey Hermes" hands-free wake word: always-on, on-device hotword detection that starts a fresh
     # voice session. Off by default; toggle with /wake.
diff --git a/tests/agent/test_image_eviction_policy.py b/tests/agent/test_image_eviction_policy.py
index 2f3cfa6de2..d6e3418863 100644
--- a/tests/agent/test_image_eviction_policy.py
+++ b/tests/agent/test_image_eviction_policy.py
@@ -11,12 +11,18 @@ from __future__ import annotations
 
 import pytest
 
+from agent.anthropic_message_convert import _evict_old_screenshots
+from agent.context_compressor import evict_stale_outbound_tool_images
 from agent.image_eviction_policy import (
     IMAGE_EVICTION_BATCH,
+    OUTBOUND_IMAGE_BUDGET_BYTES,
     OUTBOUND_IMAGE_FLOOR,
     OUTBOUND_IMAGE_LIMIT,
     outbound_image_retire_count,
+    resolve_outbound_image_budget_bytes,
+    resolve_outbound_image_limit,
 )
+from hermes_cli.config import get_config_path
 
 MB = 1_000_000
 
@@ -66,3 +72,66 @@ def test_quantum_shrinks_to_the_fit_window_for_heavy_carriers():
     assert all(3 * (n - c) <= OUTBOUND_IMAGE_LIMIT for n, c in zip(range(window + 1, window + 10), counts))
     moves = sum(a != b for a, b in zip(counts, counts[1:]))
     assert moves <= len(counts) // (window - OUTBOUND_IMAGE_FLOOR)
+
+
+def _write_config(text: str) -> None:
+    path = get_config_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+
+
+def _openai_request(n: int) -> list[dict]:
+    return [
+        {
+            "role": "tool",
+            "tool_call_id": f"call_{i}",
+            "content": [{"type": "image_url", "image_url": {"url": f"data:image/png;base64,A{i}"}}],
+        }
+        for i in range(n)
+    ]
+
+
+def _anthropic_request(n: int) -> list[dict]:
+    img = {"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": "A"}}
+    return [{
+        "role": "user",
+        "content": [
+            {"type": "tool_result", "tool_use_id": f"call_{i}", "content": [dict(img)]}
+            for i in range(n)
+        ],
+    }]
+
+
+def _anthropic_kept(request: list[dict]) -> int:
+    return sum(
+        any(part.get("type") == "image" for part in block["content"])
+        for block in request[0]["content"]
+    )
+
+
+def test_both_passes_follow_the_configured_limit():
+    """``vision.outbound_image_limit`` moves the frontier of BOTH send paths together: at the
+    raised ceiling nothing is rewritten, one over it the same batch retires on each wire shape."""
+    _write_config("vision:\n  outbound_image_limit: 40\n")
+
+    for n, retired in ((40, 0), (41, IMAGE_EVICTION_BATCH)):
+        openai = _openai_request(n)
+        anthropic = _anthropic_request(n)
+        assert evict_stale_outbound_tool_images(openai) == retired
+        _evict_old_screenshots(anthropic)
+        assert _anthropic_kept(anthropic) == n - retired
+
+
+@pytest.mark.parametrize(
+    ("section", "limit", "budget"),
+    [
+        ("", OUTBOUND_IMAGE_LIMIT, OUTBOUND_IMAGE_BUDGET_BYTES),
+        ("  outbound_image_limit: 1000\n  outbound_image_budget_mb: 64\n", 100, 30 * MB),
+        ("  outbound_image_limit: 1\n  outbound_image_budget_mb: 0\n", OUTBOUND_IMAGE_FLOOR + 1, 1 * MB),
+        ("  outbound_image_limit: lots\n  outbound_image_budget_mb: true\n", OUTBOUND_IMAGE_LIMIT, OUTBOUND_IMAGE_BUDGET_BYTES),
+    ],
+)
+def test_configured_ceilings_are_clamped_to_what_the_provider_accepts(section, limit, budget):
+    _write_config("vision:\n" + section)
+    assert resolve_outbound_image_limit() == limit
+    assert resolve_outbound_image_budget_bytes() == budget
-- 
