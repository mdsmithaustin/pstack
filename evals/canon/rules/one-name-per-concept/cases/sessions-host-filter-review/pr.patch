+@pytest.mark.asyncio
+async def test_list_sends_host_id_filter() -> None:
+    """``host_id`` travels as the ``host_id`` query parameter."""
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        assert request.url.path == "/v1/sessions"
+        assert request.url.params["host_id"] == "a1b2c3d4e5f67890abcdef1234567890"
+        return httpx.Response(200, json={"data": []})
+
+    ns, client = _make_namespace(handler)
+    try:
+        assert await ns.list(host_id="a1b2c3d4e5f67890abcdef1234567890") == []
+    finally:
+        await client.aclose()
+
