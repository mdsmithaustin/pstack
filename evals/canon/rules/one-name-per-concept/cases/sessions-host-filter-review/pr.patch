+# ── GET /v1/sessions?host_id= (filter) ───────────────────────────────
+
+
+async def test_list_sessions_filtered_by_host(
+    client: httpx.AsyncClient,
+    db_uri: str,
+) -> None:
+    """``?host_id=`` returns only sessions launched on that host."""
+    agent_store = SqlAlchemyAgentStore(db_uri)
+    conv_store = SqlAlchemyConversationStore(db_uri)
+    agent_id = generate_agent_id()
+    agent_store.create(agent_id, name="host-agent", bundle_location="test:///bundle")
+    laptop = "bdda8ba7e34130318b54dd872eb160af"
+    desktop = "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
+    on_laptop = conv_store.create_conversation(agent_id=agent_id)
+    on_desktop = conv_store.create_conversation(agent_id=agent_id)
+    conv_store.create_conversation(agent_id=agent_id)  # never bound to a host
+    conv_store.set_host_id(on_laptop.id, laptop, workspace="/tmp/laptop")
+    conv_store.set_host_id(on_desktop.id, desktop, workspace="/tmp/desktop")
+
+    resp = await client.get("/v1/sessions", params={"host_id": laptop})
+    assert resp.status_code == 200
+    data = resp.json()["data"]
+    assert [s["id"] for s in data] == [on_laptop.id]
+    assert data[0]["host_id"] == laptop
