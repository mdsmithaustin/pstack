+            if host_id is not None:
+                # The host binding lives on the Omnigent-side metadata row, so
+                # resolve it the way the project filter resolves membership.
+                host_stmt = select(SqlConversationMetadata.id).where(
+                    SqlConversationMetadata.workspace_id == current_workspace_id(),
+                    SqlConversationMetadata.host_id == host_id,
+                )
+                if self._conv_engine is self._engine:
+                    # Single-DB: an IN subquery, no ids through Python.
+                    on_host: Any = host_stmt
+                else:
+                    # Split-DB: prefetch, bounded to qualifying_ids when
+                    # permission-scoped so the IN list stays small.
+                    if qualifying_ids is not None:
+                        host_stmt = host_stmt.where(SqlConversationMetadata.id.in_(qualifying_ids))
+                    with self._session("list_conversations") as meta_sess:
+                        on_host = list(meta_sess.execute(host_stmt).scalars())
+                stmt = stmt.where(SqlConversation.id.in_(on_host))
