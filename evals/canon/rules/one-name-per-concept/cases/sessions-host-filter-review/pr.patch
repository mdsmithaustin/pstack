+def test_list_conversations_filters_by_host_id(
+    conversation_store: SqlAlchemyConversationStore,
+) -> None:
+    """``host_id`` keeps only conversations bound to that host; a rebind moves
+    a conversation between hosts, and unbound conversations never match."""
+    laptop = "bdda8ba7e34130318b54dd872eb160af"
+    desktop = "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
+    first = conversation_store.create_conversation(title="first")
+    second = conversation_store.create_conversation(title="second")
+    conversation_store.create_conversation(title="unbound")
+    conversation_store.set_host_id(first.id, laptop, workspace="/tmp/a")
+    conversation_store.set_host_id(second.id, desktop, workspace="/tmp/b")
+
+    assert [c.id for c in conversation_store.list_conversations(host_id=laptop).data] == [first.id]
+
+    conversation_store.set_host_id(second.id, laptop, workspace="/tmp/b")
+    on_laptop = conversation_store.list_conversations(host_id=laptop, order="asc")
+    assert [c.id for c in on_laptop.data] == [first.id, second.id]
+    assert conversation_store.list_conversations(host_id=desktop).data == []
+
