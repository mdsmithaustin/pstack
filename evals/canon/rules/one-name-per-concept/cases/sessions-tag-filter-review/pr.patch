+def _parse_tag_filter(tag: str) -> tuple[str, str | None]:
+    """Split a ``?tag=`` filter into the tag key and optional value.
+
+    :param tag: ``"key:value"`` to match an exact value, or ``"key"``
+        to match any value, e.g. ``"team:infra"``.
+    :returns: ``(key, value)``, with ``value`` ``None`` when the filter
+        names only a key.
+    :raises OmnigentError: 400 if the key is empty or names a per-user
+        pin key, which never crosses the API boundary.
+    """
+    key, sep, value = tag.partition(":")
+    if not key:
+        raise OmnigentError(
+            f"tag filter {tag!r} must start with a key, e.g. 'team:infra'",
+            code=ErrorCode.INVALID_INPUT,
+        )
+    if key == PINNED_LABEL_KEY or key.startswith(f"{PINNED_LABEL_KEY}."):
+        raise OmnigentError(
+            "pins cannot be used as a tag filter; use pinned=true instead",
+            code=ErrorCode.INVALID_INPUT,
+        )
+    return key, value if sep else None
+
+
