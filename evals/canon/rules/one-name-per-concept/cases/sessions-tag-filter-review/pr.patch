diff --git a/tests/server/routes/test_sessions_crud.py b/tests/server/routes/test_sessions_crud.py
index fe2f04aa4..f289818b5 100644
--- a/tests/server/routes/test_sessions_crud.py
+++ b/tests/server/routes/test_sessions_crud.py
@@ -788,3 +788,38 @@ async def test_list_sessions_pinned_filter(
     assert plain.id not in ids
     # A pin belonging to another user must not appear for the caller.
     assert other_user_pin.id not in ids
+
+
+# ── GET /v1/sessions?tag= (filter) ───────────────────────────────────
+
+
+async def test_list_sessions_filtered_by_tag(
+    client: httpx.AsyncClient,
+    db_uri: str,
+) -> None:
+    """``?tag=key:value`` matches the exact value; ``?tag=key`` any value."""
+    agent_store = SqlAlchemyAgentStore(db_uri)
+    conv_store = SqlAlchemyConversationStore(db_uri)
+    agent_id = generate_agent_id()
+    agent_store.create(agent_id, name="tag-agent", bundle_location="test:///bundle")
+    infra = conv_store.create_conversation(agent_id=agent_id)
+    web = conv_store.create_conversation(agent_id=agent_id)
+    untagged = conv_store.create_conversation(agent_id=agent_id)
+    conv_store.set_labels(infra.id, {"team": "infra"})
+    conv_store.set_labels(web.id, {"team": "web"})
+
+    resp = await client.get("/v1/sessions", params={"tag": "team:infra"})
+    assert resp.status_code == 200
+    assert [s["id"] for s in resp.json()["data"]] == [infra.id]
+
+    resp = await client.get("/v1/sessions", params={"tag": "team", "order": "asc"})
+    assert resp.status_code == 200
+    assert [s["id"] for s in resp.json()["data"]] == [infra.id, web.id]
+    assert untagged.id not in [s["id"] for s in resp.json()["data"]]
+
+
+@pytest.mark.parametrize("tag", [":infra", "omnigent.pinned", "omnigent.pinned.bob:1"])
+async def test_list_sessions_rejects_invalid_tag(client: httpx.AsyncClient, tag: str) -> None:
+    """An empty key or a pin key is a 400, not a silent empty page."""
+    resp = await client.get("/v1/sessions", params={"tag": tag})
+    assert resp.status_code == 400
