@@ -0,0 +1,119 @@
+"""Tests for failed-login throttling on the accounts ``POST /auth/login``."""
+
+from __future__ import annotations
+
+import secrets
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from omnigent.db.utils import get_or_create_engine
+from omnigent.server.accounts_config import AccountsConfig
+from omnigent.server.accounts_store import SqlAlchemyAccountStore
+from omnigent.server.admin_list import AdminList
+from omnigent.server.auth import (
+    LoginThrottle,
+    LoginThrottleConfig,
+    UnifiedAuthProvider,
+    resolve_login_throttle_config,
+)
+from omnigent.server.passwords import hash_password
+from omnigent.server.routes.accounts_auth import create_accounts_auth_router
+
+
+def _throttle(max_failures: int) -> tuple[LoginThrottle, list[float]]:
+    now = [50.0]
+    config = LoginThrottleConfig(max_failures=max_failures, window_seconds=60, lockout_seconds=120)
+    return LoginThrottle(config, clock=lambda: now[0]), now
+
+
+def test_username_locks_after_max_failures_and_unlocks_after_lockout() -> None:
+    throttle, now = _throttle(3)
+    for _ in range(2):
+        throttle.record_failure("alice")
+    assert throttle.retry_after("alice") is None
+
+    throttle.record_failure("alice")
+    assert throttle.retry_after("alice") == 120
+    now[0] += 119.5
+    assert throttle.retry_after("alice") == 1
+    now[0] += 0.5
+    assert throttle.retry_after("alice") is None
+
+
+def test_failures_outside_the_window_do_not_add_up() -> None:
+    throttle, now = _throttle(2)
+    throttle.record_failure("alice")
+    now[0] += 61
+    throttle.record_failure("alice")
+    assert throttle.retry_after("alice") is None
+    throttle.record_failure("alice")
+    assert throttle.retry_after("alice") == 120
+
+
+def test_success_clears_the_count_and_other_users_are_unaffected() -> None:
+    throttle, _ = _throttle(2)
+    throttle.record_failure("alice")
+    throttle.record_success("alice")
+    throttle.record_failure("alice")
+    throttle.record_failure("bob")
+    throttle.record_failure("bob")
+    assert (throttle.retry_after("alice"), throttle.retry_after("bob")) == (None, 120)
+
+
+def test_config_reads_env_and_falls_back_on_bad_values(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("OMNIGENT_LOGIN_MAX_FAILURES", "2")
+    monkeypatch.setenv("OMNIGENT_LOGIN_FAILURE_WINDOW_SECONDS", "ten")
+    monkeypatch.setenv("OMNIGENT_LOGIN_LOCKOUT_SECONDS", "-5")
+    assert resolve_login_throttle_config() == LoginThrottleConfig(
+        max_failures=2, window_seconds=900, lockout_seconds=900
+    )
+
+
+@pytest.fixture
+def login_client(tmp_path: Path) -> Iterator[TestClient]:
+    db_url = f"sqlite:///{tmp_path}/accounts.db"
+    get_or_create_engine(db_url)
+    store = SqlAlchemyAccountStore(db_url)
+    store.create_user_with_password("alice", hash_password("correct-horse-1"))
+    config = AccountsConfig(
+        cookie_secret=secrets.token_bytes(32),
+        session_ttl_hours=8,
+        base_url="http://localhost:8000",
+        init_admin_password=None,
+        invite_ttl_seconds=3600,
+        magic_ttl_seconds=600,
+    )
+    provider = UnifiedAuthProvider(source="accounts", accounts_config=config)
+    throttle = LoginThrottle(LoginThrottleConfig(max_failures=3, lockout_seconds=300))
+    app = FastAPI()
+    app.include_router(
+        create_accounts_auth_router(
+            provider, store, AdminList(tmp_path / "admins"), login_throttle=throttle
+        ),
+        prefix="/auth",
+    )
+    with TestClient(app) as client:
+        yield client
+
+
+def test_login_refuses_a_locked_username_even_with_the_right_password(
+    login_client: TestClient,
+) -> None:
+    wrong = {"username": "Alice", "password": "wrong-password"}
+    codes = [login_client.post("/auth/login", json=wrong).status_code for _ in range(3)]
+    assert codes == [401, 401, 401]
+
+    right = {"username": "alice", "password": "correct-horse-1"}
+    resp = login_client.post("/auth/login", json=right)
+    assert resp.status_code == 429
+    assert int(resp.headers["Retry-After"]) in range(299, 301)
+
+
+def test_unknown_usernames_are_throttled_like_real_ones(login_client: TestClient) -> None:
+    ghost = {"username": "ghost", "password": "anything-12345"}
+    codes = [login_client.post("/auth/login", json=ghost).status_code for _ in range(4)]
+    assert codes == [401, 401, 401, 429]
