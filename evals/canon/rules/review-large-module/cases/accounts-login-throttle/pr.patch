+# Failed-login budget for the accounts ``POST /auth/login``, keyed on the
+# normalized username so rotating client IPs cannot reset it. Unknown names
+# count too, so a 429 never reveals whether an account exists.
+_LOGIN_MAX_FAILURES_ENV = "OMNIGENT_LOGIN_MAX_FAILURES"
+_LOGIN_FAILURE_WINDOW_ENV = "OMNIGENT_LOGIN_FAILURE_WINDOW_SECONDS"
+_LOGIN_LOCKOUT_ENV = "OMNIGENT_LOGIN_LOCKOUT_SECONDS"
+_DEFAULT_LOGIN_MAX_FAILURES = 5
+_DEFAULT_LOGIN_FAILURE_WINDOW_SECONDS = 900
+_DEFAULT_LOGIN_LOCKOUT_SECONDS = 900
+# Cap on tracked usernames so a spray of random names cannot exhaust memory;
+# unlocked entries are dropped first, oldest first.
+_LOGIN_THROTTLE_MAX_TRACKED = 10_000
+
+
+@dataclass(frozen=True)
+class LoginThrottleConfig:
+    """Failed-login budget for the accounts password login.
+
+    :param max_failures: Failures allowed per username within
+        *window_seconds* before it is locked, e.g. ``5``. ``0`` turns
+        throttling off.
+    :param window_seconds: Window failures are counted in, from the
+        first counted failure, e.g. ``900``.
+    :param lockout_seconds: How long a locked username is refused.
+    """
+
+    max_failures: int = _DEFAULT_LOGIN_MAX_FAILURES
+    window_seconds: int = _DEFAULT_LOGIN_FAILURE_WINDOW_SECONDS
+    lockout_seconds: int = _DEFAULT_LOGIN_LOCKOUT_SECONDS
+
+    @property
+    def enabled(self) -> bool:
+        """Whether any budget applies (``max_failures`` above zero)."""
+        return self.max_failures > 0
+
+
+def _env_non_negative_int(name: str, default: int) -> int:
+    """Parse a non-negative integer env var, warning and falling back on bad values."""
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        value = int(raw)
+    except ValueError:
+        logger.warning("%s=%r is not an integer; using %d", name, raw, default)
+        return default
+    if value < 0:
+        logger.warning("%s=%d is negative; using %d", name, value, default)
+        return default
+    return value
+
+
+def resolve_login_throttle_config() -> LoginThrottleConfig:
+    """Read the failed-login budget from the environment.
+
+    ``OMNIGENT_LOGIN_MAX_FAILURES`` (default 5; ``0`` turns throttling
+    off), ``OMNIGENT_LOGIN_FAILURE_WINDOW_SECONDS`` and
+    ``OMNIGENT_LOGIN_LOCKOUT_SECONDS`` (both default 900). A malformed
+    or negative value falls back to its default with a warning.
+
+    :returns: The resolved :class:`LoginThrottleConfig`.
+    """
+    return LoginThrottleConfig(
+        max_failures=_env_non_negative_int(_LOGIN_MAX_FAILURES_ENV, _DEFAULT_LOGIN_MAX_FAILURES),
+        window_seconds=_env_non_negative_int(
+            _LOGIN_FAILURE_WINDOW_ENV, _DEFAULT_LOGIN_FAILURE_WINDOW_SECONDS
+        ),
+        lockout_seconds=_env_non_negative_int(_LOGIN_LOCKOUT_ENV, _DEFAULT_LOGIN_LOCKOUT_SECONDS),
+    )
+
+
+@dataclass
+class _LoginFailures:
+    window_started_at: float
+    count: int = 0
+    locked_until: float = 0.0
+
+
+class LoginThrottle:
+    """Per-process failed-login counter for the accounts password login.
+
+    Built once per accounts router (see
+    :func:`omnigent.server.routes.accounts_auth.create_accounts_auth_router`).
+    Counts live in this process only: a deployment running N replicas
+    allows up to N times the budget, which still turns online guessing
+    from unbounded into a handful of tries per window.
+
+    :param config: The failure budget.
+    :param clock: Monotonic clock in seconds. Injectable for tests.
+    """
+
+    def __init__(
+        self,
+        config: LoginThrottleConfig,
+        *,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self._config = config
+        self._clock = clock
+        self._failures: dict[str, _LoginFailures] = {}
+
+    def retry_after(self, username: str) -> int | None:
+        """Whole seconds until *username* may try again, or ``None`` if allowed now.
+
+        :param username: Normalized (stripped, lowercased) username.
+        """
+        entry = self._failures.get(username)
+        if not self._config.enabled or entry is None:
+            return None
+        remaining = entry.locked_until - self._clock()
+        return math.ceil(remaining) if remaining > 0 else None
+
+    def record_failure(self, username: str) -> None:
+        """Count one failed attempt and lock *username* once the budget is spent.
+
+        :param username: Normalized (stripped, lowercased) username.
+        """
+        if not self._config.enabled:
+            return
+        now = self._clock()
+        entry = self._failures.pop(username, None)
+        if entry is None or now - entry.window_started_at >= self._config.window_seconds:
+            locked_until = entry.locked_until if entry is not None else 0.0
+            entry = _LoginFailures(window_started_at=now, locked_until=locked_until)
+        entry.count += 1
+        if entry.count >= self._config.max_failures:
+            entry.locked_until = now + self._config.lockout_seconds
+            entry.window_started_at = now
+            entry.count = 0
+        # Re-inserting keeps the dict ordered from least to most recently failed.
+        self._failures[username] = entry
+        if len(self._failures) > _LOGIN_THROTTLE_MAX_TRACKED:
+            self._drop_oldest(now)
+
+    def record_success(self, username: str) -> None:
+        """Clear *username*'s failures after a successful login.
+
+        :param username: Normalized (stripped, lowercased) username.
+        """
+        self._failures.pop(username, None)
+
+    def _drop_oldest(self, now: float) -> None:
+        names = self._failures
+        unlocked = next((name for name, e in names.items() if e.locked_until <= now), None)
+        del names[unlocked if unlocked is not None else next(iter(names))]
+
+
