index 0000000..ddb8678
--- /dev/null
+++ b/tests/db/test_sqlite_migration_backup.py
@@ -0,0 +1,125 @@
+"""Tests for the SQLite copy taken before an automatic schema upgrade."""
+
+from __future__ import annotations
+
+import sqlite3
+from contextlib import closing
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from alembic import command
+from sqlalchemy import create_engine
+
+from omnigent.db.utils import (
+    _build_alembic_config,
+    _get_current_db_revision,
+    _get_head_db_revision,
+    _initialize_or_verify_schema,
+    backup_sqlite_database,
+)
+
+# The previous head before c9d3a1f2e4b5 added conversations.runner_id.
+STALE_REVISION = "8a4f1e9c2b07"
+SEPT_1 = datetime(2026, 9, 1, 12, 0, 0, tzinfo=timezone.utc)
+
+
+def _make_db_at_revision(db_path: Path, revision: str) -> str:
+    uri = f"sqlite:///{db_path}"
+    engine = create_engine(uri)
+    config = _build_alembic_config(uri)
+    try:
+        with engine.begin() as conn:
+            config.attributes["connection"] = conn
+            command.upgrade(config, revision)
+    finally:
+        engine.dispose()
+    return uri
+
+
+def _revision_in(path: Path) -> str:
+    with closing(sqlite3.connect(path)) as conn:
+        return conn.execute("SELECT version_num FROM alembic_version").fetchone()[0]
+
+
+def test_backup_copies_the_rows_and_keeps_the_file_private(tmp_path: Path) -> None:
+    db_path = tmp_path / "app.db"
+    with closing(sqlite3.connect(db_path)) as conn:
+        conn.execute("CREATE TABLE notes (body TEXT)")
+        conn.execute("INSERT INTO notes VALUES ('keep me')")
+        conn.commit()
+    db_path.chmod(0o600)
+
+    backup = backup_sqlite_database(f"sqlite:///{db_path}", "rev1", keep=3, now=SEPT_1)
+
+    assert backup == tmp_path / "app.db.pre-migrate-20260901T120000Z-rev1"
+    with closing(sqlite3.connect(backup)) as conn:
+        assert conn.execute("SELECT body FROM notes").fetchall() == [("keep me",)]
+    assert backup.stat().st_mode & 0o777 == 0o600
+
+
+def test_only_the_newest_backups_are_kept(tmp_path: Path) -> None:
+    db_path = tmp_path / "app.db"
+    sqlite3.connect(db_path).close()
+    for day in range(4):
+        backup_sqlite_database(
+            f"sqlite:///{db_path}", "rev1", keep=2, now=SEPT_1 + timedelta(days=day)
+        )
+
+    assert sorted(p.name for p in tmp_path.iterdir() if p != db_path) == [
+        "app.db.pre-migrate-20260903T120000Z-rev1",
+        "app.db.pre-migrate-20260904T120000Z-rev1",
+    ]
+
+
+def test_nothing_is_written_without_a_sqlite_file(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    db_path = tmp_path / "app.db"
+    sqlite3.connect(db_path).close()
+    monkeypatch.setenv("OMNIGENT_SQLITE_BACKUP_KEEP", "0")
+
+    assert [
+        backup_sqlite_database(f"sqlite:///{db_path}", "rev1"),
+        backup_sqlite_database(f"sqlite:///{tmp_path / 'missing.db'}", "rev1", keep=3),
+        backup_sqlite_database("sqlite:///:memory:", "rev1", keep=3),
+        backup_sqlite_database("postgresql://u:p@localhost/omnigent", "rev1", keep=3),
+    ] == [None, None, None, None]
+    assert [p.name for p in tmp_path.iterdir()] == ["app.db"]
+
+
+def test_stale_database_is_backed_up_before_the_automatic_upgrade(tmp_path: Path) -> None:
+    uri = _make_db_at_revision(tmp_path / "stale.db", STALE_REVISION)
+
+    engine = create_engine(uri)
+    try:
+        _initialize_or_verify_schema(engine, uri)
+        assert _get_current_db_revision(engine) == _get_head_db_revision(uri)
+    finally:
+        engine.dispose()
+
+    (backup,) = tmp_path.glob("stale.db.pre-migrate-*")
+    assert backup.name.endswith(f"-{STALE_REVISION}")
+    assert _revision_in(backup) == STALE_REVISION
+
+
+def test_failed_upgrade_points_the_operator_at_the_backup(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    uri = _make_db_at_revision(tmp_path / "stale.db", STALE_REVISION)
+
+    def _fail_migration(*_args: object, **_kwargs: object) -> None:
+        raise RuntimeError("boom")
+
+    monkeypatch.setattr("omnigent.db.utils._run_migrations", _fail_migration)
+    engine = create_engine(uri)
+    try:
+        with pytest.raises(RuntimeError) as exc_info:
+            _initialize_or_verify_schema(engine, uri)
+    finally:
+        engine.dispose()
+
+    (backup,) = tmp_path.glob("stale.db.pre-migrate-*")
+    assert f"A copy of the database from before this attempt is at {backup}." in str(
+        exc_info.value
+    )
