+# ── SQLite backups before automatic migrations ────────────
+#
+# An automatic upgrade rewrites tables in place. For a local SQLite file, a copy
+# taken just before it is the cheapest way back if the upgrade fails midway.
+
+_SQLITE_BACKUP_KEEP_ENV = "OMNIGENT_SQLITE_BACKUP_KEEP"
+_DEFAULT_SQLITE_BACKUP_KEEP = 3
+_SQLITE_BACKUP_MARKER = ".pre-migrate-"
+
+
+def sqlite_database_path(db_uri: str) -> Path | None:
+    """
+    Return the file behind a SQLite URL, or ``None`` when there is none.
+
+    :param db_uri: SQLAlchemy database URL, e.g.
+        ``"sqlite:////home/me/.omnigent/omnigent.db"``.
+    :returns: The absolute database path, or ``None`` for other
+        dialects and in-memory databases.
+    """
+    url = make_url(db_uri)
+    if url.get_backend_name() != "sqlite" or url.database in (None, "", ":memory:"):
+        return None
+    return Path(url.database).expanduser().resolve()
+
+
+def backup_sqlite_database(
+    db_uri: str,
+    from_revision: str,
+    *,
+    keep: int | None = None,
+    now: datetime | None = None,
+) -> Path | None:
+    """
+    Copy a SQLite database aside before its schema is upgraded.
+
+    Writes ``<db file>.pre-migrate-<UTC time>-<from_revision>`` next to
+    the database through SQLite's online backup API, which includes
+    committed WAL contents and is safe while other connections are
+    open. The copy gets the source file's permission bits. Only the
+    newest *keep* backups of that database are kept. When the disk has
+    less free space than the database, the backup is skipped with a
+    warning rather than failing startup.
+
+    :param db_uri: SQLAlchemy database URL, e.g.
+        ``"sqlite:////home/me/.omnigent/omnigent.db"``.
+    :param from_revision: The revision being upgraded from, e.g.
+        ``"8a4f1e9c2b07"``.
+    :param keep: How many backups to keep. ``None`` reads
+        ``OMNIGENT_SQLITE_BACKUP_KEEP`` (default 3); ``0`` writes none.
+    :param now: Timestamp for the file name; defaults to now (UTC).
+    :returns: The backup path, or ``None`` when no backup was written
+        (not SQLite, in-memory, no file yet, or disabled).
+    """
+    import sqlite3
+
+    if keep is None:
+        keep = _env_int(_SQLITE_BACKUP_KEEP_ENV, _DEFAULT_SQLITE_BACKUP_KEEP, minimum=0)
+    source = sqlite_database_path(db_uri)
+    if keep == 0 or source is None or not source.is_file():
+        return None
+    size = source.stat().st_size
+    free = shutil.disk_usage(source.parent).free
+    if free < size:
+        _logger.warning(
+            "Skipping the pre-migration backup of %s: %d bytes free, database is %d bytes",
+            source,
+            free,
+            size,
+        )
+        return None
+    stamp = (now or datetime.now(timezone.utc)).strftime("%Y%m%dT%H%M%SZ")
+    prefix = f"{source.name}{_SQLITE_BACKUP_MARKER}"
+    target = source.with_name(f"{prefix}{stamp}-{from_revision}")
+    # Create the file with the source's mode so a 0600 database never has a
+    # world-readable copy, even briefly.
+    os.close(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, source.stat().st_mode & 0o777))
+    try:
+        with closing(sqlite3.connect(source)) as src, closing(sqlite3.connect(target)) as dst:
+            src.backup(dst)
+    except BaseException:
+        target.unlink(missing_ok=True)
+        raise
+    # Timestamps are fixed-width, so name order is age order.
+    backups = sorted(path for path in source.parent.iterdir() if path.name.startswith(prefix))
+    for stale in backups[:-keep]:
+        stale.unlink(missing_ok=True)
+    _logger.info("Backed up %s to %s before migrating from %s", source, target, from_revision)
+    return target
+
+
+def _backup_hint(backup: Path | None) -> str:
+    """The recovery sentence for a failed automatic migration."""
+    if backup is None:
+        return "Take a backup of your database, then run"
+    return f"A copy of the database from before this attempt is at {backup}. Run"
+
+
