+
+    def conversation_usage(self, session_id: str) -> Dict[str, float]:
+        """Tokens and spend summed over every row of the compressed conversation."""
+        chain = self.get_compression_chain(session_id)
+        row = self._read_one(f"""
+            SELECT COALESCE(SUM(COALESCE(input_tokens, 0)), 0),
+                   COALESCE(SUM(COALESCE(output_tokens, 0)), 0),
+                   COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd, 0)), 0)
+              FROM sessions
+             WHERE id IN ({','.join('?' * len(chain))})
+            """, chain)
+        return {"sessions": len(chain), "input_tokens": int(row[0] or 0),
+                "output_tokens": int(row[1] or 0), "cost_usd": float(row[2] or 0.0)}
