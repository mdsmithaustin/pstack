+
+    def lineage_usage(self, session_id: str) -> Dict[str, float]:
+        """Tokens and spend summed over the session's compression lineage, root to tip. A /branch copy
+        is its own lineage, so its spend never joins its source's."""
+        lineage = self.get_compression_lineage(session_id)
+        if not lineage:
+            return {}
+        row = self._read_one(f"""
+            SELECT COALESCE(SUM(COALESCE(input_tokens, 0)), 0),
+                   COALESCE(SUM(COALESCE(output_tokens, 0)), 0),
+                   COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd, 0)), 0)
+              FROM sessions
+             WHERE id IN ({','.join('?' * len(lineage))})
+            """, lineage)
+        return {"sessions": len(lineage), "input_tokens": int(row[0] or 0),
+                "output_tokens": int(row[1] or 0), "cost_usd": float(row[2] or 0.0)}
