diff --git a/hermes_state_compression.py b/hermes_state_compression.py
index 7ea1e41..b99baaa 100644
--- a/hermes_state_compression.py
+++ b/hermes_state_compression.py
@@ -672,6 +672,31 @@ class SessionCompressionMixin:
             chain.append(child_id)
         return chain
 
+    def session_tree(self, session_id: str) -> Optional[Dict[str, Any]]:
+        """The session tree rooted at *session_id*: each node holds its continuations and its branches.
+        ``/fork`` is only the CLI alias of ``/branch``, so fork children are branches here."""
+        session = self.get_session(session_id)
+        if not session:
+            return None
+        seen = {session_id}
+
+        def grow(node: Dict[str, Any]) -> Dict[str, Any]:
+            continuations, branches = [], []
+            for row in self._read_all("SELECT * FROM sessions WHERE parent_session_id = ? ORDER BY started_at ASC",
+                                      (node["id"],)):
+                child = dict(row)
+                if child["id"] in seen:
+                    continue
+                seen.add(child["id"])
+                if self._is_compression_child_row(child):
+                    continuations.append(grow(child))
+                elif self._is_explicit_branch_session(child["id"]):
+                    branches.append(grow(child))
+            return {"id": node["id"], "title": node.get("title"), "end_reason": node.get("end_reason"),
+                    "continuations": continuations, "branches": branches}
+
+        return grow(session)
+
     def get_compression_tip(self, session_id: str) -> Optional[str]:
         """Live tip of a compression chain (``get_compression_chain`` semantics); the input
         id when no continuation exists."""
