     print(f"\nRepaired {repaired} of {len(adoptable)} session(s).")
 
 
+def _print_session_tree(node, depth=0, kind="session"):
+    title = node.get("title") or "untitled"
+    print(f"{'  ' * depth}{kind}: {node['id']}  {title}")
+    for continuation in node["continuations"]:
+        _print_session_tree(continuation, depth + 1, "continuation")
+    for branch in node["branches"]:
+        _print_session_tree(branch, depth + 1, "branch")
+
+
+def _cmd_tree(db, args):
+    session_tree = db.session_tree(args.session_id)
+    if session_tree is None:
+        print(f"Session not found: {args.session_id}")
+        return
+    _print_session_tree(session_tree)
+
+
