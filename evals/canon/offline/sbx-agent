#!/usr/bin/env python3
"""Stand-in for Claude or Codex inside a sandbox, spending no model budget.

  sbx-agent plan                    on the host, in the harness workspace: pick the sample
  sbx-agent PLAN claude|codex ARG... inside the sandbox: check the run's shape, edit, answer

sandbox.py runs `plan` when CANON_SBX_STANDIN names this file, copies the file
and its plan into the sandbox, and runs it in place of the agent. The plan
picks samples/good for a near-miss case or any arm but current, and bad for
current, so a correct pipeline prints SEPARATES for each positive case.

Inside, it exits 3 unless the prompt starts with the agent's explicit
invocation and the skills are linked where the agent finds them, 4 unless the
poteto-agent persona is registered, 5 unless the flags give it full tools in
the sandbox, and 6 unless its cwd is the pinned clone. Then it applies the
sample diff, prints a trace in the agent's own format with one worklist call
and one poteto-agent spawn, and writes session transcripts for the lead and
the delegate where the agent keeps them.
"""
import json
import os
import subprocess
import sys
import uuid
from pathlib import Path

INVOCATION = {"claude": ("/poteto-mode ", ".claude/skills", ".claude/agents/poteto-agent.md"),
              "codex": ("$poteto-mode ", ".agents/skills", ".codex/agents/poteto-agent.toml")}


def plan():
    import importlib.util
    canon = Path(__file__).resolve().parents[1]
    spec = importlib.util.spec_from_file_location("canon_screen", canon / "screen.py")
    screen = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(screen)
    arm_input = Path(os.environ["CANON_WORKSPACE"])
    rule_id, case_id, arm = arm_input.parts[-4:-1]
    rule = screen.load_rule(rule_id)
    case = next(case for case in rule.cases if case.id == case_id)
    sample = "good" if case.kind == "near-miss" or arm != "current" else "bad"
    build = json.loads((arm_input.parents[2] / "build.json").read_text())
    changed = build.get("arm_changes", {}).get(arm) or [build["target"]]
    print(json.dumps({
        "rule": rule_id, "case": case_id, "arm": arm,
        "answer": (case.root / "samples" / f"{sample}.md").read_text(),
        "diff": (case.root / "samples" / f"{sample}.diff").read_text(),
        "reads": changed,
    }))


def fail(code, why):
    print(f"sbx-agent: {why}", file=sys.stderr)
    sys.exit(code)


def check_shape(agent, argv, prompt):
    token, discovery, persona = INVOCATION[agent]
    if Path("skills", "pstack").is_dir():
        if not prompt.startswith(token) or len(prompt[len(token):].strip()) < 20 or not Path(discovery, "poteto-mode", "SKILL.md").is_file():
            fail(3, "the prompt lacks the invocation or the task, or the skills are not linked")
        if not Path(persona).is_file():
            fail(4, "the poteto-agent persona is not registered")
    wanted = ["--permission-mode", "bypassPermissions", "--allowedTools", "TodoWrite"] if agent == "claude" else ["--sandbox", "danger-full-access"]
    if any(flag not in argv for flag in wanted):
        fail(5, f"missing {wanted}")
    if not Path(".git").is_dir():
        fail(6, "no clone in cwd")
    return discovery


def claude(plan_data, argv, prompt):
    discovery = check_shape("claude", argv, prompt)
    cwd, session, spawn = os.getcwd(), str(uuid.uuid4()), "toolu_standin_spawn"
    brief = "Data shape: the orders module keeps one amend function. Success: the tests pass."
    def call(use_id, name, arguments):
        return [
            {"type": "assistant", "message": {"role": "assistant", "content": [{"type": "tool_use", "id": use_id, "name": name, "input": arguments}]},
             "parent_tool_use_id": None, "session_id": session},
            {"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": use_id, "content": "ok"}]},
             "parent_tool_use_id": None, "session_id": session},
        ]

    records = [
        {"type": "system", "subtype": "init", "cwd": cwd, "session_id": session, "permissionMode": "bypassPermissions",
         "tools": ["Task", "Bash", "Edit", "Read", "TaskCreate", "TaskUpdate", "TaskList", "Write"],
         "agents": ["general-purpose", "poteto-agent"], "slash_commands": ["poteto-mode"]},
        *call("toolu_standin_list", "TaskCreate", {"subject": "Step 1", "description": "Trace the change"}),
        *[record for index, path in enumerate(plan_data["reads"])
          for record in call(f"toolu_standin_read{index}", "Read", {"file_path": f"{cwd}/{discovery}/{path}"})],
        *call(spawn, "Task", {"subagent_type": "poteto-agent", "description": "Build", "prompt": brief}),
        {"type": "result", "subtype": "success", "is_error": False, "result": plan_data["answer"], "session_id": session,
         "total_cost_usd": 0, "usage": {"input_tokens": 0, "output_tokens": 0}},
    ]
    subprocess.run(["git", "apply", "--binary", "-"], input=plan_data["diff"].encode(), check=True)
    project = Path.home() / ".claude" / "projects" / cwd.replace("/", "-").replace(".", "-")
    (project / session / "subagents").mkdir(parents=True, exist_ok=True)
    (project / f"{session}.jsonl").write_text("".join(json.dumps(record) + "\n" for record in records[1:-1]))
    child = [
        {"type": "user", "isSidechain": True, "agentId": "astandin", "sessionId": session, "cwd": cwd, "message": {"role": "user", "content": brief}},
        {"type": "assistant", "isSidechain": True, "agentId": "astandin", "sessionId": session, "cwd": cwd, "message": {"role": "assistant", "content": [
            {"type": "tool_use", "id": "toolu_child_read", "name": "Read", "input": {"file_path": f"{cwd}/{discovery}/poteto-mode/SKILL.md"}}]}},
        {"type": "assistant", "isSidechain": True, "agentId": "astandin", "sessionId": session, "cwd": cwd, "message": {"role": "assistant", "content": [
            {"type": "text", "text": "done"}]}},
    ]
    (project / session / "subagents" / "agent-astandin.jsonl").write_text("".join(json.dumps(record) + "\n" for record in child))
    (project / session / "subagents" / "agent-astandin.meta.json").write_text(json.dumps(
        {"agentType": "poteto-agent", "description": "Build", "toolUseId": spawn, "spawnDepth": 1}))
    for record in records:
        print(json.dumps(record), flush=True)


def codex(plan_data, argv, prompt):
    discovery = check_shape("codex", argv, prompt)
    cwd, parent, child = os.getcwd(), str(uuid.uuid4()), str(uuid.uuid4())
    brief = "Data shape: the orders module keeps one amend function. Success: the tests pass."
    subprocess.run(["git", "apply", "--binary", "-"], input=plan_data["diff"].encode(), check=True)
    Path(argv[argv.index("--output-last-message") + 1]).write_text(plan_data["answer"])
    sessions = Path.home() / ".codex" / "sessions" / "2026" / "09" / "25"
    sessions.mkdir(parents=True, exist_ok=True)

    def item(kind, body):
        return {"type": "event_msg", "payload": {"type": "item_completed", "thread_id": parent, "item": {"type": kind, **body}}}

    (sessions / f"rollout-2026-09-25T00-00-00-{parent}.jsonl").write_text("".join(json.dumps(record) + "\n" for record in [
        {"type": "session_meta", "payload": {"id": parent, "session_id": parent, "cwd": cwd, "source": "exec"}},
        item("CollabAgentToolCall", {"tool": "spawn_agent", "prompt": brief, "receiver_thread_ids": [child],
                                     "receiver_agents": [{"thread_id": child, "agent_role": "poteto-agent"}]}),
    ]))
    (sessions / f"rollout-2026-09-25T00-00-01-{child}.jsonl").write_text("".join(json.dumps(record) + "\n" for record in [
        {"type": "session_meta", "payload": {"id": child, "session_id": parent, "parent_thread_id": parent, "cwd": cwd, "agent_role": "poteto-agent",
                                             "source": {"subagent": {"thread_spawn": {"parent_thread_id": parent, "depth": 1, "agent_role": "poteto-agent"}}}}},
        {"type": "response_item", "payload": {"type": "message", "role": "developer", "content": [{"type": "input_text", "text": "Pstack installed skill paths\n"}]}},
        {"type": "event_msg", "payload": {"type": "item_completed", "thread_id": child, "item": {
            "type": "CommandExecution", "command": ["/bin/bash", "-lc", f"sed -n '1,400p' {cwd}/{discovery}/poteto-mode/SKILL.md"],
            "cwd": f"file://{cwd}", "status": "completed", "exit_code": 0,
            "parsed_cmd": [{"type": "read", "path": f"{cwd}/{discovery}/poteto-mode/SKILL.md"}]}}},
    ]))
    for event in (
        {"type": "thread.started", "thread_id": parent},
        {"type": "turn.started"},
        {"type": "item.completed", "item": {"id": "plan", "type": "todo_list", "items": [{"text": "Trace the change", "completed": False}]}},
        *[{"type": "item.completed", "item": {"id": f"read{index}", "type": "command_execution", "command": f"sed -n 1,400p {discovery}/{path}",
                                              "aggregated_output": "", "exit_code": 0, "status": "completed"}} for index, path in enumerate(plan_data["reads"])],
        {"type": "item.completed", "item": {"id": "spawn", "type": "collab_tool_call", "tool": "spawn_agent", "sender_thread_id": parent,
                                            "receiver_thread_ids": [child], "prompt": brief, "agents_states": {}, "status": "completed"}},
        {"type": "item.completed", "item": {"id": "answer", "type": "agent_message", "text": plan_data["answer"]}},
        {"type": "turn.completed", "usage": {"input_tokens": 0, "output_tokens": 0}},
    ):
        print(json.dumps(event), flush=True)


def main():
    if sys.argv[1:] == ["plan"]:
        return plan()
    plan_data = json.loads(Path(sys.argv[1]).read_text())
    agent, argv = sys.argv[2], sys.argv[3:]
    prompt = sys.stdin.read()
    {"claude": claude, "codex": codex}[agent](plan_data, argv, prompt)


if __name__ == "__main__":
    main()
