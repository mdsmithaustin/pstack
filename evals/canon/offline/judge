#!/usr/bin/env python3
"""Stand-in judge that spends no model budget.

  judge BACKEND MODEL < prompt

review.invoke runs it when CANON_JUDGE_STANDIN names this file. It finds the
labeled calibration sample that carries the prompt's judged text, in any
review or document case under $CANON_RULES (default rules/), and answers with
that label as the verdict. A review is judged whole, so its sample equals the
judged text. A document is cut from the sample, so the judged text sits inside
the sample; the shortest sample that holds it wins. The stand-in agents answer
with those same samples, so a correct pipeline judges each run as its sample is
labeled. It exits 2 when no sample matches or the label is not a verdict the
schema allows.
"""
import json
import os
import re
import sys
from pathlib import Path

RULES = Path(os.environ.get("CANON_RULES", Path(__file__).resolve().parents[1] / "rules"))


def squash(text):
    return " ".join(text.split())


def main():
    prompt = sys.stdin.read()
    match = re.search(r'<(review|document) label="[^"]*">\n(.*?)\n</\1>', prompt, re.DOTALL)
    if not match:
        sys.exit(2)
    judged = squash(match.group(2))
    allowed = json.loads(os.environ["CANON_JUDGE_SCHEMA"])["properties"]["verdict"]["enum"]
    holders = []
    for labels in sorted(RULES.glob("*/cases/*/samples/labels.json")):
        for name, label in json.loads(labels.read_text()).items():
            sample = squash((labels.parent / name).read_text())
            if judged in sample and label in allowed:
                holders.append((len(sample), name, label))
    if not holders:
        sys.exit(2)
    _, _, label = min(holders)
    print(json.dumps({"verdict": label, "evidence": judged[:80]}))


if __name__ == "__main__":
    main()
