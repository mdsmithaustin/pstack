{
  "agents": {
    "claude": {
      "kit": "claude",
      "harness": "claude-code",
      "discovery": ".claude/skills",
      "transcripts": {
        "from": ".claude/projects",
        "to": "claude"
      },
      "api": [
        "api.anthropic.com"
      ]
    },
    "codex": {
      "kit": "codex",
      "harness": "codex",
      "discovery": ".agents/skills",
      "transcripts": {
        "from": ".codex/sessions",
        "to": "codex/sessions"
      },
      "api": [
        "chatgpt.com",
        "api.openai.com"
      ],
      "cli": "@openai/codex@0.160.0"
    }
  },
  "uv": "0.12.17",
  "repos": {
    "omnigent": {
      "python": "3.12",
      "sync": [
        "--frozen"
      ],
      "env": {
        "OMNIGENT_SKIP_WEB_UI": "true"
      },
      "package": "omnigent",
      "tools": {
        "group": "test",
        "extra": "dev"
      }
    },
    "hermes": {
      "python": "3.11",
      "sync": [
        "--frozen"
      ],
      "package": "hermes_cli",
      "tools": {
        "group": "dev",
        "extra": "dev"
      }
    }
  },
  "build_network": [
    "pypi.org",
    "files.pythonhosted.org",
    "github.com",
    "objects.githubusercontent.com",
    "release-assets.githubusercontent.com",
    "releases.astral.sh",
    "registry.npmjs.org"
  ],
  "run_deny_network": [
    "api.github.com",
    "archive.ubuntu.com",
    "bridge.claudeusercontent.com",
    "claude.com",
    "code.claude.com",
    "codeload.github.com",
    "download.docker.com",
    "downloads.claude.ai",
    "files.pythonhosted.org",
    "github.com",
    "mcp-proxy.anthropic.com",
    "objects.githubusercontent.com",
    "platform.claude.com",
    "ports.ubuntu.com",
    "pypi.org",
    "raw.githubusercontent.com",
    "registry.npmjs.org",
    "release-assets.githubusercontent.com",
    "releases.astral.sh",
    "security.ubuntu.com"
  ]
}
