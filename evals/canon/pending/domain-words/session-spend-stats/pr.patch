From 27143cecbe04143ddf7ad90d674af66ec3ba3f8b Mon Sep 17 00:00:00 2001
From: Tomasz Wierzbicki <tomasz.wierzbicki@example.com>
Date: Fri, 25 Sep 2026 17:20:40 -0600
Subject: [PATCH 1/2] feat(state): sum tokens and spend over a session's
 compression chain

Compression ends a session and starts a new row, so a long run's usage is
split across every row it rotated through and no single row says what the
run cost. chain_usage() walks get_compression_lineage() root to tip and
sums the token and spend columns; any member of the chain gives the same
totals, and a /branch copy stays out of its source's numbers.
---
 hermes_state_usage.py                  | 26 +++++++++++++
 tests/hermes_state/test_chain_usage.py | 54 ++++++++++++++++++++++++++
 2 files changed, 80 insertions(+)
 create mode 100644 tests/hermes_state/test_chain_usage.py

diff --git a/hermes_state_usage.py b/hermes_state_usage.py
index 06ea514c55..b95ef9c430 100644
--- a/hermes_state_usage.py
+++ b/hermes_state_usage.py
@@ -419,6 +419,32 @@ class SessionUsageMixin:
         )
         return {row["task"]: {k: row[k] for k in row.keys() if k != "task"} for row in rows}
 
+    def chain_usage(self, session_id: str) -> Dict[str, Any]:
+        """Tokens and spend summed over the compression chain ``session_id`` belongs to, root through
+        tip, whichever member is passed. Compression mints a new row mid-run, so one row only holds the
+        spend since the last split. A ``/branch`` copy is a chain of its own and never absorbs its
+        source's rows (``get_compression_lineage`` stops at it). Spend prefers billed over estimated,
+        as in :meth:`usage_totals`. ``{}`` for an unknown id."""
+        chain = self.get_compression_lineage(session_id)
+        if not chain:
+            return {}
+        row = self._read_one(f"""
+            SELECT COALESCE(SUM(api_call_count), 0),
+                   COALESCE(SUM(input_tokens), 0),
+                   COALESCE(SUM(output_tokens), 0),
+                   COALESCE(SUM(cache_read_tokens), 0),
+                   COALESCE(SUM(cache_write_tokens), 0),
+                   COALESCE(SUM(reasoning_tokens), 0),
+                   COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd, 0)), 0)
+              FROM sessions
+             WHERE id IN ({','.join('?' * len(chain))})
+            """, chain)
+        return {
+            "session_ids": chain, "api_calls": int(row[0]), "input_tokens": int(row[1]),
+            "output_tokens": int(row[2]), "cache_read_tokens": int(row[3]), "cache_write_tokens": int(row[4]),
+            "reasoning_tokens": int(row[5]), "cost_usd": float(row[6]),
+        }
+
     def usage_totals(self, *, min_message_count: int = 1, include_archived: bool = False) -> Dict[str, float]:
         """Tokens and spend across the whole store (one scan), so the sidebar total does not
         shrink with paging. Spend prefers the billed figure over the estimate."""
diff --git a/tests/hermes_state/test_chain_usage.py b/tests/hermes_state/test_chain_usage.py
new file mode 100644
index 0000000000..bf7692b7b2
--- /dev/null
+++ b/tests/hermes_state/test_chain_usage.py
@@ -0,0 +1,54 @@
+"""chain_usage sums tokens and spend over a compression chain, root through tip."""
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture()
+def db(tmp_path):
+    session_db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        yield session_db
+    finally:
+        session_db.close()
+
+
+def _run(db, session_id, *, parent=None, input_tokens, output_tokens, cost, compressed=True, **kwargs):
+    db.create_session(session_id, source="cli", parent_session_id=parent, **kwargs)
+    db.update_token_counts(
+        session_id, input_tokens=input_tokens, output_tokens=output_tokens,
+        estimated_cost_usd=cost, api_call_count=1,
+    )
+    if compressed:
+        db.end_session(session_id, "compression")
+
+
+def test_every_member_of_a_chain_reports_the_same_totals(db):
+    _run(db, "root", input_tokens=1000, output_tokens=100, cost=0.25)
+    _run(db, "mid", parent="root", input_tokens=2000, output_tokens=200, cost=0.5)
+    _run(db, "tip", parent="mid", input_tokens=400, output_tokens=40, cost=0.125, compressed=False)
+
+    totals = [db.chain_usage(session_id) for session_id in ("root", "mid", "tip")]
+
+    assert totals[0] == totals[1] == totals[2]
+    assert totals[0]["session_ids"] == ["root", "mid", "tip"]
+    assert totals[0]["input_tokens"] == 1000 + 2000 + 400
+    assert totals[0]["output_tokens"] == 100 + 200 + 40
+    assert totals[0]["api_calls"] == 3
+    assert totals[0]["cost_usd"] == pytest.approx(0.25 + 0.5 + 0.125)
+
+
+def test_branch_keeps_its_own_spend_out_of_its_source_chain(db):
+    _run(db, "root", input_tokens=1000, output_tokens=100, cost=0.25)
+    _run(db, "tip", parent="root", input_tokens=400, output_tokens=40, cost=0.125, compressed=False)
+    _run(db, "branch", parent="root", input_tokens=9000, output_tokens=900, cost=2.0, compressed=False,
+         model_config={"_branched_from": "root"})
+
+    source, branch = db.chain_usage("tip"), db.chain_usage("branch")
+
+    assert source["session_ids"] == ["root", "tip"]
+    assert source["input_tokens"] == 1400
+    assert branch["session_ids"] == ["branch"]
+    assert branch["input_tokens"] == 9000
+    assert db.chain_usage("missing") == {}
