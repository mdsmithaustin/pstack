diff --git a/tests/hermes_cli/test_sessions_stats_chain.py b/tests/hermes_cli/test_sessions_stats_chain.py
new file mode 100644
index 0000000000..33af918f4f
--- /dev/null
+++ b/tests/hermes_cli/test_sessions_stats_chain.py
@@ -0,0 +1,51 @@
+"""`hermes sessions stats <id>` prints one total for a run that compression split across rows."""
+
+import argparse
+
+import pytest
+
+import hermes_cli.sessions_cmd as sessions_cmd
+
+
+@pytest.fixture
+def state_db(monkeypatch, tmp_path):
+    import hermes_state
+    from hermes_state import SessionDB
+
+    db_path = tmp_path / "state.db"
+    monkeypatch.setattr(hermes_state, "_default_db_path", lambda: db_path)
+    seed = SessionDB(db_path=db_path)
+    for session_id, parent, tokens in (("20260901_aaaa", None, 1200), ("20260901_bbbb", "20260901_aaaa", 800)):
+        seed.create_session(session_id, "cli", parent_session_id=parent)
+        seed.update_token_counts(session_id, input_tokens=tokens, output_tokens=tokens // 10,
+                                 estimated_cost_usd=tokens / 1000, api_call_count=2)
+    seed.end_session("20260901_aaaa", "compression")
+    seed.close()
+    return db_path
+
+
+def _parse(*argv):
+    from hermes_cli.subcommands.sessions import build_sessions_parser
+
+    parser = argparse.ArgumentParser()
+    build_sessions_parser(parser.add_subparsers(dest="command"), cmd_sessions=sessions_cmd.cmd_sessions)
+    return parser.parse_args(["sessions", *argv])
+
+
+def test_stats_with_an_id_sums_the_whole_compression_chain(state_db, capsys):
+    assert sessions_cmd.cmd_sessions(_parse("stats", "20260901_bb")) is None
+
+    out = capsys.readouterr().out
+    assert "Compression chain: 2 sessions (20260901_aaaa -> 20260901_bbbb)" in out
+    assert "Input tokens: 2,000" in out
+    assert "Output tokens: 200" in out
+    assert "API calls: 4" in out
+    assert "Spend: $2.0000" in out
+
+
+def test_stats_with_an_unknown_id_fails_and_without_one_keeps_store_counts(state_db, capsys):
+    assert sessions_cmd.cmd_sessions(_parse("stats", "nope")) == 1
+    assert "No session 'nope'" in capsys.readouterr().out
+
+    assert sessions_cmd.cmd_sessions(_parse("stats")) is None
+    assert "Total sessions: 2" in capsys.readouterr().out
diff --git a/website/docs/user-guide/sessions.md b/website/docs/user-guide/sessions.md
index 6362ff984a..1aadb069fa 100644
--- a/website/docs/user-guide/sessions.md
+++ b/website/docs/user-guide/sessions.md
@@ -612,6 +612,24 @@ Total messages: 3847
 Database size: 12.4 MB
 ```
 
+Pass a session ID (or a unique prefix) to see what one run used. Compression
+starts a new session row each time it runs, so the totals are summed over the
+whole compression chain, root to tip, whichever session of the chain you name.
+A `/branch` copy keeps its own totals.
+
+```bash
+hermes sessions stats 20250305_0915
+```
+
+```
+Session: 20250305_091523_a1b2c3d4
+Compression chain: 3 sessions (20250305_091523_a1b2c3d4 -> 20250305_114208_e5f6a7b8)
+API calls: 61
+Input tokens: 1,482,915
+Output tokens: 38,204
+Spend: $4.1872
+```
+
 For deeper analytics — token usage, cost estimates, tool breakdown, and activity patterns — use [`hermes insights`](../reference/cli-commands.md#hermes-insights).
 
