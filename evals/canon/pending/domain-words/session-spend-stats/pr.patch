From ab2a3814250bae812818164b8aeea9db0ca0b534 Mon Sep 17 00:00:00 2001
From: Tomasz Wierzbicki <tomasz.wierzbicki@example.com>
Date: Fri, 25 Sep 2026 17:20:40 -0600
Subject: [PATCH 2/2] feat(sessions): hermes sessions stats <id> prints one
 run's tokens and spend

stats takes an optional session id or unique prefix. With one, it prints
API calls, input/output (and cache/reasoning when present) tokens and
spend summed over the session's compression chain, plus the chain's root
and tip when compression split it. Without one, output is unchanged.
---
 hermes_cli/sessions_cmd.py                    | 26 +++++++++-
 hermes_cli/subcommands/sessions.py            |  8 ++-
 tests/hermes_cli/test_sessions_stats_chain.py | 51 +++++++++++++++++++
 website/docs/user-guide/sessions.md           | 18 +++++++
 4 files changed, 101 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_sessions_stats_chain.py

diff --git a/hermes_cli/sessions_cmd.py b/hermes_cli/sessions_cmd.py
index a10305f970..0c149c84ec 100644
--- a/hermes_cli/sessions_cmd.py
+++ b/hermes_cli/sessions_cmd.py
@@ -975,6 +975,8 @@ def _cmd_repair_routing(db, args):
 
 
 def _cmd_stats(db, args):
+    if getattr(args, "session_id", None):
+        return _print_chain_usage(db, args.session_id)
     print(f"Total sessions: {db.session_count()}\nTotal messages: {db.message_count()}")
     for src in ("cli", "telegram", "discord", "whatsapp", "slack"):
         if (c := db.session_count(source=src)) > 0:
@@ -983,6 +985,26 @@ def _cmd_stats(db, args):
         print(f"Database size: {_size_mb(db.db_path):.1f} MB")
 
 
+def _print_chain_usage(db, session_id):
+    """`hermes sessions stats <id>`: one session's tokens and spend across its compression chain."""
+    resolved = db.resolve_session_id(session_id)
+    if not resolved:
+        return _not_found(session_id)
+    usage = db.chain_usage(resolved)
+    chain = usage["session_ids"]
+    print(f"Session: {resolved}")
+    if len(chain) > 1:
+        print(f"Compression chain: {len(chain)} sessions ({chain[0]} -> {chain[-1]})")
+    print(f"API calls: {usage['api_calls']:,}")
+    print(f"Input tokens: {usage['input_tokens']:,}")
+    print(f"Output tokens: {usage['output_tokens']:,}")
+    if usage["cache_read_tokens"] or usage["cache_write_tokens"]:
+        print(f"Cache read/write tokens: {usage['cache_read_tokens']:,} / {usage['cache_write_tokens']:,}")
+    if usage["reasoning_tokens"]:
+        print(f"Reasoning tokens: {usage['reasoning_tokens']:,}")
+    print(f"Spend: ${usage['cost_usd']:.4f}")
+
+
