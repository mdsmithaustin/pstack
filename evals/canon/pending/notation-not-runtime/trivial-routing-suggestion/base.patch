index 000000000..d4fbed38e
--- /dev/null
+++ b/tests/policies/builtins/features/trivial_routing.feature
@@ -0,0 +1,36 @@
+Feature: Keep trivial tasks off expensive models
+  The routing policy classifies the user's message before a request
+  reaches an operator-gated model, and denies the request when the task
+  is trivial.
+
+  Background:
+    Given the routing policy gates "databricks-claude-opus-4-6"
+
+  Scenario: A trivial task sent to a gated model is denied
+    Given the classifier rates the message trivial
+    When the agent sends "What is 2+2?" to "databricks-claude-opus-4-6"
+    Then the call is denied
+    And the session remembers "What is 2+2?" as trivial
+
+  Scenario: A complex task sent to a gated model is allowed
+    Given the classifier rates the message complex
+    When the agent sends "Refactor the billing module" to "databricks-claude-opus-4-6"
+    Then the call is allowed
+    And the session remembers "Refactor the billing module" as complex
+
+  Scenario: A later round-trip in the same turn reuses the verdict
+    Given the session already rated "What is 2+2?" trivial
+    When the agent sends "What is 2+2?" to "databricks-claude-opus-4-6"
+    Then the call is denied
+    And the classifier was not asked
+
+  Scenario: A model outside the gate is never classified
+    Given the classifier rates the message trivial
+    When the agent sends "What is 2+2?" to "databricks-claude-haiku-4-5"
+    Then the policy abstains
+    And the classifier was not asked
+
+  Scenario: Without a server LLM client the policy abstains
+    Given the server has no LLM client
+    When the agent sends "What is 2+2?" to "databricks-claude-opus-4-6"
+    Then the policy abstains
diff --git a/tests/policies/builtins/test_trivial_routing_scenarios.py b/tests/policies/builtins/test_trivial_routing_scenarios.py
new file mode 100644
index 000000000..9b2f83a52
--- /dev/null
+++ b/tests/policies/builtins/test_trivial_routing_scenarios.py
@@ -0,0 +1,107 @@
+"""
+Step definitions for ``features/trivial_routing.feature``.
+
+Drives :func:`omnigent.policies.builtins.routing.deny_trivial_to_expensive_model`
+with a stub classifier and checks the verdict the agent would see.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+from pytest_bdd import given, parsers, scenarios, then, when
+
+from omnigent.policies.builtins.routing import (
+    _CACHE_KEY_PREFIX,
+    deny_trivial_to_expensive_model,
+)
+
+from .helpers import llm_request_event
+
+scenarios("features/trivial_routing.feature")
+
+
+class _StubResponse:
+    """Classifier response exposing ``output_text`` like the SDK ``Response``."""
+
+    def __init__(self, output_text: str) -> None:
+        self.output_text = output_text
+
+
+class _StubClient:
+    """``PolicyLLMClient`` stand-in whose ``create`` is an ``AsyncMock``."""
+
+    def __init__(self) -> None:
+        self.create = AsyncMock()
+
+
+def _cache_key(message: str) -> str:
+    return f"{_CACHE_KEY_PREFIX}{hashlib.sha256(message.encode()).hexdigest()[:16]}"
+
+
+@pytest.fixture
+def routing() -> dict[str, Any]:
+    """Mutable state shared by the steps of one scenario."""
+    client = _StubClient()
+    return {"session_state": {}, "classifier": client.create, "llm_client": client}
+
+
+@given(parsers.parse('the routing policy gates "{model}"'))
+def gated_model(routing: dict[str, Any], model: str) -> None:
+    routing["expensive_models"] = [model]
+
+
+@given(parsers.parse("the classifier rates the message {difficulty}"))
+def classifier_rating(routing: dict[str, Any], difficulty: str) -> None:
+    body = json.dumps({"difficulty": difficulty.upper()})
+    routing["classifier"].return_value = _StubResponse(body)
+
+
+@given(parsers.parse('the session already rated "{message}" {difficulty}'))
+def cached_rating(routing: dict[str, Any], message: str, difficulty: str) -> None:
+    routing["session_state"][_cache_key(message)] = difficulty.upper()
+
+
+@given("the server has no LLM client")
+def no_llm_client(routing: dict[str, Any]) -> None:
+    routing["llm_client"] = None
+
+
+@when(parsers.parse('the agent sends "{message}" to "{model}"'))
+def send(routing: dict[str, Any], message: str, model: str) -> None:
+    policy = deny_trivial_to_expensive_model(expensive_models=routing["expensive_models"])
+    event = llm_request_event(model=model, last_user_message=message)
+    event["session_state"] = routing["session_state"]
+    event["llm_client"] = routing["llm_client"]
+    routing["verdict"] = asyncio.run(policy(event))
+
+
+@then("the call is denied")
+def denied(routing: dict[str, Any]) -> None:
+    assert routing["verdict"]["result"] == "DENY"
+
+
+@then("the call is allowed")
+def allowed(routing: dict[str, Any]) -> None:
+    assert routing["verdict"]["result"] == "ALLOW"
+
+
+@then("the policy abstains")
+def abstains(routing: dict[str, Any]) -> None:
+    assert routing["verdict"] is None
+
+
+@then(parsers.parse('the session remembers "{message}" as {difficulty}'))
+def remembered(routing: dict[str, Any], message: str, difficulty: str) -> None:
+    update = {"key": _cache_key(message), "action": "set", "value": difficulty.upper()}
+    assert update in routing["verdict"]["state_updates"]
+
+
+@then("the classifier was not asked")
+def classifier_not_asked(routing: dict[str, Any]) -> None:
+    routing["classifier"].assert_not_awaited()
