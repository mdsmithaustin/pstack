#!/usr/bin/env python3
import json
import os
import subprocess
import sys
from pathlib import Path

forge = Path(os.environ.get("GIT_DIR", ".")).resolve().parent
protected = set(json.loads((forge / "state.json").read_text(encoding="utf-8")).get("protected", []))
updates = [line.split() for line in sys.stdin.read().splitlines() if line.strip()]
blocked = [ref for _, _, ref in updates if ref.startswith("refs/heads/") and ref[len("refs/heads/"):] in protected]
with open(forge / "pushes.jsonl", "a", encoding="utf-8") as log:
    for old, new, ref in updates:
        created, deleted = set(old) == {"0"}, set(new) == {"0"}
        forced = not created and not deleted and subprocess.run(
            ["git", "merge-base", "--is-ancestor", old, new], capture_output=True).returncode != 0
        reason = None
        if ref in blocked:
            reason = "protected branch"
        elif blocked:
            reason = "another ref in the push was rejected"
        log.write(json.dumps({"ref": ref, "old": old, "new": new, "created": created, "deleted": deleted,
                              "forced": forced, "rejected": bool(blocked), "reason": reason}) + "\n")
for ref in blocked:
    print(f"error: GH006: Protected branch update failed for {ref}.", file=sys.stderr)
    print("error: Changes must be made through a pull request.", file=sys.stderr)
sys.exit(1 if blocked else 0)
