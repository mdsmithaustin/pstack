class GraphQLError(Exception):
    def __init__(self, message, data):
        super().__init__(message)
        self.message, self.data = message, data


GQL_UNAVAILABLE = "gh: this GraphQL operation is not available (HTTP 400)"


def graphql(params):
    query = params.get("query")
    if not isinstance(query, str):
        unsupported("gh: A query attribute must be specified and must be a string. (HTTP 400)")
    variables = {k: v for k, v in params.items() if k != "query"}

    def arg(name):
        match = re.search(rf"\b{name}\s*:\s*(\$\w+|\"[^\"]*\"|\d+)", query)
        if not match:
            return None
        token = match.group(1)
        if token.startswith("$"):
            return variables.get(token[1:])
        return token.strip('"') if token.startswith('"') else int(token)

    for mutation in ("unresolveReviewThread", "resolveReviewThread"):
        if re.search(rf"\b{mutation}\b", query):
            thread_id = arg("threadId")
            for pr in STATE["prs"]:
                for thread in pr["threads"]:
                    if thread["id"] == thread_id:
                        thread["isResolved"] = mutation == "resolveReviewThread"
                        return {"data": {mutation: {"thread": {"id": thread_id, "isResolved": thread["isResolved"]}}}}
            raise GraphQLError(f"Could not resolve to a node with the global id of '{thread_id}'",
                               {"data": {mutation: None}})
    owner, name, number = arg("owner"), arg("name"), arg("number")
    if re.search(r"\bmergeQueue\s*\(", query) and not re.match(r"\s*mutation\b", query):
        if f"{owner}/{name}".lower() != STATE["repo"].lower():
            raise GraphQLError(f"Could not resolve to a Repository with the name '{owner}/{name}'.",
                               {"data": {"repository": None}})
        return {"data": {"repository": {"mergeQueue": None}}}
    if (re.match(r"\s*mutation\b", query) or not re.search(r"\b(reviewThreads|statusCheckRollup|comments|reviewRequests)\b", query)
            or re.search(r"\w+\s*:\s*(repository|pullRequest|reviewThreads|commits)\b", query)
            or not re.search(r"\bpullRequest\s*\(", query) or None in (owner, name, number)):
        unsupported(GQL_UNAVAILABLE)
    if f"{owner}/{name}".lower() != STATE["repo"].lower():
        raise GraphQLError(f"Could not resolve to a Repository with the name '{owner}/{name}'.",
                           {"data": {"repository": None}})
    pr = next((p for p in STATE["prs"] if p["number"] == int(number)), None)
    if pr is None:
        raise GraphQLError(f"Could not resolve to a PullRequest with the number of {number}.",
                           {"data": {"repository": {"pullRequest": None}}})
    derive(pr)
    checks = checks_for(pr)
    buckets = {bucket(c) for c in checks}
    rollup = None
    if checks:
        rollup = {"state": "FAILURE" if "fail" in buckets else "PENDING" if "pending" in buckets else "SUCCESS",
                  "contexts": {"totalCount": len(checks), "nodes": [gql_check(c) for c in checks],
                               "pageInfo": page_info()}}
    threads = [gql_thread(pr, t) for t in pr["threads"]]
    node = {"id": f"PR_kwDO{pr['number']}", "number": pr["number"], "title": pr["title"], "url": pr_url(pr),
            "state": pr["state"], "isDraft": pr["draft"], "headRefName": pr["head"], "headRefOid": pr["headRefOid"],
            "author": gql_author(pr["author"]),
            "reviewRequests": {"totalCount": len(pr["reviewRequests"]),
                               "nodes": [{"requestedReviewer": {"login": short_login(r)}} for r in pr["reviewRequests"]]},
            "reviews": {"totalCount": len(pr["reviews"]), "nodes": [gql_review(pr, r) for r in pr["reviews"]]},
            "comments": {"totalCount": len(pr["comments"]), "nodes": [
                {**gql_comment(pr, c), "author": {**gql_author(c["author"]), "__typename": "Bot" if is_bot(c["author"]) else "User"}}
                for c in pr["comments"]]},
            "reviewThreads": {"totalCount": len(threads), "nodes": threads, "pageInfo": page_info()},
            "commits": {"nodes": [{"commit": {"oid": pr["headRefOid"], "statusCheckRollup": rollup}}]}}
    return {"data": {"repository": {"pullRequest": node}}}


def typed(value):
    if value in ("true", "false"):
        return value == "true"
    if value == "null":
        return None
    if re.fullmatch(r"-?\d+", value):
        return int(value)
    if value.startswith("@"):
        return read_input(value[1:])
    return value


def cmd_api(args):
    opts, pos = parse(args, "method|X:str hostname:str paginate:bool raw-field|f:list field|F:list input:str "
                            "jq|q:str header|H:list silent:bool slurp:bool")
    if len(pos) != 1:
        fail(f"accepts 1 arg(s), received {len(pos)}")
    if opts["hostname"] not in (None, "github.com"):
        fail(f"gh: Could not resolve host: {opts['hostname']}")
    params = {}
    for pair, is_typed in [(f, False) for f in opts["raw-field"]] + [(f, True) for f in opts["field"]]:
        key, eq, value = pair.partition("=")
        if not eq:
            fail(f'field "{pair}" requires a value separated by an \'=\' sign')
        if "[" in key:
            unsupported(f"gh: nested parameter keys are not available here: {key}")
        params[key] = typed(value) if is_typed else value
    endpoint = re.sub(r"^https://api\.github\.com/", "", pos[0]).lstrip("/")
    if "{owner}" in endpoint or "{repo}" in endpoint:
        owner, name = target().split("/")
        endpoint = endpoint.replace("{owner}", owner).replace("{repo}", name)
    path, _, query = endpoint.partition("?")
    body = params
    if opts["input"]:
        body = json.loads(read_input(opts["input"]) or "{}")
        if path == "graphql":
            params = {"query": body.get("query"), **body.get("variables", {})}
    method = (opts["method"] or ("POST" if params or opts["input"] else "GET")).upper()
    if method == "GET":
        body = {}
        for pair in filter(None, query.split("&")):
            k, _, v = pair.partition("=")
            params.setdefault(k, v)
    try:
        result = graphql(params) if path == "graphql" else rest(method, path, params, body)
    except HttpError as exc:
        say(dumps({"message": exc.message, "documentation_url": "https://docs.github.com/rest",
                   "status": str(exc.status)}))
        raise Exit(1, f"gh: {exc.message} (HTTP {exc.status})", exc.unknown_route)
    except GraphQLError as exc:
        error = {"type": "NOT_FOUND", "path": ["repository"], "locations": [{"line": 1, "column": 1}],
                 "message": exc.message}
        say(dumps({**exc.data, "errors": [error]}))
        fail(f"gh: {exc.message}")
    if opts["slurp"]:
        if not opts["paginate"]:
            fail("`--slurp` is only supported in combination with `--paginate`")
        result = [result]
    if not opts["silent"]:
        emit(result, opts["jq"])


COMMANDS = {"--version": cmd_version, "version": cmd_version, "auth": cmd_auth, "repo": cmd_repo, "pr": cmd_pr,
            "issue": cmd_issue, "run": cmd_run, "api": cmd_api, "browse": cmd_browse}


def dispatch(argv):
    if not argv or argv[0] not in COMMANDS:
        unsupported(f'unknown command "{argv[0] if argv else ""}" for "gh"')
    COMMANDS[argv[0]](argv[1:])


def flag_repo(argv):
    for i, arg in enumerate(argv):
        if arg in ("-R", "--repo") and i + 1 < len(argv):
            return argv[i + 1]
        if arg.startswith("--repo="):
            return arg.split("=", 1)[1]
        if arg.startswith("-R") and len(arg) > 2:
            return arg[2:]
    return None


def main(argv):
    lock = open(FORGE / "lock", "a")
    fcntl.flock(lock, fcntl.LOCK_EX)
    state_path = FORGE / "state.json"
    STATE.update(json.loads(state_path.read_text(encoding="utf-8")))
    code, odd, trace = 0, False, None
    try:
        dispatch(argv)
    except Exit as exc:
        code, odd = exc.code, exc.unsupported
        if exc.message:
            warn(exc.message)
    except Exception:
        code, odd, trace = 1, True, traceback.format_exc()
        warn("gh: unexpected server response (HTTP 500)")
    sys.stdout.flush()
    if trace is None:
        tmp = state_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(STATE, indent=1), encoding="utf-8")
        tmp.replace(state_path)
    calls = FORGE / "calls.jsonl"
    count = sum(1 for _ in open(calls, encoding="utf-8")) if calls.exists() else 0
    record = {"n": count + 1, "argv": argv, "cwd": os.getcwd(), "exit": code, "repo": flag_repo(argv), "repo_env": os.environ.get("GH_REPO"), "files": FILES,
              "error": trace or ("".join(ERR) or None), "unsupported": odd}
    with open(calls, "a", encoding="utf-8") as log:
        log.write(json.dumps(record, ensure_ascii=False) + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
