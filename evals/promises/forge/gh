def pr_create(opts, pos):
    if pos:
        fail(f'unknown command "{pos[0]}" for "gh pr create"')
    head = opts["head"]
    if head and ":" in head:
        owner, _, head = head.partition(":")
        if owner != STATE["repo"].split("/")[0]:
            unsupported("pull request create failed: GraphQL: Head repository could not be resolved (createPullRequest)")
    explicit = bool(head)
    head = head or current_branch()
    base = opts["base"] or "main"
    if not opts["fill"] and (opts["title"] is None or opts["body"] is None and opts["body-file"] is None):
        fail("must provide `--title` and `--body` (or `--fill` or `fill-first` or `--fillverbose`) "
             "when not running interactively")
    head_oid = tip(head)
    if not head_oid:
        if explicit:
            fail(f"pull request create failed: GraphQL: Head sha can't be blank, Base sha can't be blank, "
                 f"No commits between {base} and {head}, Head ref must be a branch (createPullRequest)")
        fail("aborted: you must first push the current branch to a remote, or use the --head flag")
    base_oid = tip(base)
    if not base_oid:
        fail("pull request create failed: GraphQL: Base ref must be a branch (createPullRequest)")
    for pr in STATE["prs"]:
        if pr["state"] == "OPEN" and pr["head"] == head and pr["base"] == base:
            fail(f'a pull request for branch "{head}" into branch "{base}" already exists:\n{pr_url(pr)}')
    commits = commits_between(base_oid, head_oid)
    if not commits:
        fail(f"pull request create failed: GraphQL: No commits between {base} and {head} (createPullRequest)")
    title, body = opts["title"], opts["body"]
    if opts["body-file"] is not None:
        body = read_input(opts["body-file"])
    if opts["fill"]:
        if len(commits) == 1:
            fill_title, fill_body = commits[0]["messageHeadline"], commits[0]["messageBody"]
        else:
            fill_title = re.sub(r"[-_]", " ", head)
            fill_body = "".join(f"- {c['messageHeadline']}\n" for c in commits)
        title = fill_title if title is None else title
        body = fill_body if body is None else body
    number = STATE["next_number"]
    STATE["next_number"] += 1
    pr = {"number": number, "title": title, "body": body, "head": head, "base": base, "author": STATE["user"],
          "draft": opts["draft"], "state": "OPEN", "labels": list(opts["label"]), "reviewRequests": [], "checks": [],
          "reviews": [], "threads": [], "comments": [], "createdAt": now(), "mergedAt": None, "closedAt": None,
          "mergeCommit": None, "autoMergeRequest": None, "headRefOid": head_oid, "baseRefOid": base_oid,
          "mergeable": "UNKNOWN", "mergeStateStatus": "UNKNOWN"}
    STATE["prs"].append(pr)
    derive(pr)
    say(pr_url(pr))


def pr_view(opts, pos):
    need_json(opts)
    fields = json_fields(opts["json"], PR_FIELDS)
    pr = pr_arg(pos, "gh pr view [<number> | <url> | <branch>] [flags]")
    derive(pr)
    if fields:
        emit(export(pr, fields, PR_FIELDS), opts["jq"])
        return
    files = pr_files(pr)
    state = "DRAFT" if pr["draft"] and pr["state"] == "OPEN" else pr["state"]
    reviewers = ", ".join([f"{short_login(r)} (Requested)" for r in pr["reviewRequests"]] +
                          [f"{short_login(r['author'])} ({r['state'].title().replace('_', ' ')})"
                           for r in latest_reviews(pr)])
    auto = "enabled" if pr["autoMergeRequest"] else "disabled"
    say(f"title:\t{pr['title']}\nstate:\t{state}\nauthor:\t{pr['author']}\nlabels:\t{', '.join(pr['labels'])}\n"
        f"assignees:\t\nreviewers:\t{reviewers}\nprojects:\t\nmilestone:\t\nnumber:\t{pr['number']}\n"
        f"url:\t{pr_url(pr)}\nadditions:\t{sum(f['additions'] for f in files)}\n"
        f"deletions:\t{sum(f['deletions'] for f in files)}\nauto-merge:\t{auto}\n--\n{pr['body']}")
    if opts["comments"]:
        for c in pr["comments"]:
            say(f"author:\t{short_login(c['author'])}\nassociation:\t{association(c['author']).lower()}\n"
                f"edited:\tfalse\nstatus:\tnone\n--\n{c['body']}\n--")


def pr_list(opts, pos):
    need_json(opts)
    if pos:
        fail(f"accepts 0 arg(s), received {len(pos)}")
    state = (opts["state"] or "open").upper()
    if state not in ("OPEN", "CLOSED", "MERGED", "ALL"):
        fail(f'invalid argument "{opts["state"]}" for "-s, --state" flag: valid values are '
             '{open|closed|merged|all}')
    prs = [pr for pr in sorted(STATE["prs"], key=lambda p: -p["number"])
           if state == "ALL" or pr["state"] == state
           if opts["head"] in (None, pr["head"]) and opts["base"] in (None, pr["base"])]
    prs = prs[:int(opts["limit"] or 30)]
    for pr in prs:
        derive(pr)
    fields = json_fields(opts["json"], PR_FIELDS)
    if fields:
        emit([export(pr, fields, PR_FIELDS) for pr in prs], opts["jq"])
        return
    for pr in prs:
        shown = "DRAFT" if pr["draft"] and pr["state"] == "OPEN" else pr["state"]
        say(f"{pr['number']}\t{pr['title']}\t{pr['head']}\t{shown}\t{pr['createdAt']}")


