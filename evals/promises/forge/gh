def pr_merge(opts, pos):
    pr = pr_arg(pos, "gh pr merge [<number> | <url> | <branch>] [flags]")
    name = f"{STATE['repo']}#{pr['number']}"
    if opts["disable-auto"]:
        pr["autoMergeRequest"] = None
        warn(f"✓ Auto-merge disabled for pull request {name}")
        return
    methods = [m for m in ("squash", "merge", "rebase") if opts[m]]
    if len(methods) > 1:
        fail("only one of --merge, --rebase, or --squash can be enabled")
    if not methods:
        fail("--merge, --rebase, or --squash required when not running interactively")
    method = methods[0]
    if pr["state"] == "MERGED":
        fail(f"X Pull request {name} was already merged")
    if pr["state"] == "CLOSED":
        fail(f"X Pull request {name} is closed")
    if pr["draft"]:
        fail(f"X Pull request {name} is still a draft")
    status = merge_state(pr)
    if opts["match-head-commit"] and opts["match-head-commit"] != pr["headRefOid"]:
        fail("GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)")
    subject = opts["subject"]
    body = read_input(opts["body-file"]) if opts["body-file"] is not None else opts["body"]
    if opts["auto"] and status != "CLEAN":
        pr["autoMergeRequest"] = {"authorEmail": None, "commitBody": body, "commitHeadline": subject,
                                  "mergeMethod": method.upper(), "enabledAt": now(),
                                  "enabledBy": {"login": STATE["user"]}}
        warn(f"✓ Pull request {name} will be automatically merged via {method} when all requirements are met")
        return
    blocked = {"DIRTY": "the merge commit cannot be cleanly created",
               "BLOCKED": "the base branch policy prohibits the merge"}.get(status)
    if blocked and not (opts["admin"] and status == "BLOCKED"):
        message = (f"X Pull request {name} is not mergeable: {blocked}.\n"
                   "To have the pull request merged after all the requirements have been met, add the `--auto` flag.")
        if status == "BLOCKED":
            message += "\nTo use administrator privileges to immediately merge the pull request, add the `--admin` flag."
        fail(message)
    merge(pr, method, subject, body)
    verb = {"squash": "Squashed and merged", "merge": "Merged", "rebase": "Rebased and merged"}[method]
    warn(f"✓ {verb} pull request {name} ({pr['title']})")
    if opts["delete-branch"]:
        delete_head(pr, local=opts["repo"] is None)


def merge(pr, method, subject, body):
    base_oid, head_oid = tip(pr["base"]), pr["headRefOid"]
    tree = rgit("merge-tree", "--write-tree", "--no-messages", base_oid, head_oid).stdout.split()[0]
    owner = STATE["repo"].split("/")[0]
    if method == "merge":
        parents = [base_oid, head_oid]
        subject = subject or f"Merge pull request #{pr['number']} from {owner}/{pr['head']}"
        body = pr["title"] if body is None else body
    else:
        parents = [base_oid]
        commits = commits_between(base_oid, head_oid)
        subject = subject or f"{pr['title']} (#{pr['number']})"
        if body is None:
            body = (commits[0]["messageBody"] if len(commits) == 1
                    else "\n\n".join(f"* {c['messageHeadline']}" for c in commits))
    user = STATE["user"]
    host = "github.com"
    env = {"GIT_AUTHOR_NAME": user, "GIT_AUTHOR_EMAIL": "@".join((user, f"users.noreply.{host}")),
           "GIT_COMMITTER_NAME": "GitHub", "GIT_COMMITTER_EMAIL": "@".join(("noreply", host))}
    message = subject + (f"\n\n{body}" if body else "") + "\n"
    args = ["commit-tree", tree, *itertools.chain.from_iterable(("-p", p) for p in parents), "-m", message]
    new = rgit(*args, env=env).stdout.strip()
    rgit("update-ref", f"refs/heads/{pr['base']}", new, base_oid)
    log_push({"ref": f"refs/heads/{pr['base']}", "old": base_oid, "new": new, "created": False, "deleted": False,
              "forced": False, "rejected": False, "reason": None, "via": "merge", "pr": pr["number"],
              "method": method})
    pr.update(state="MERGED", mergedAt=now(), closedAt=now(), mergeCommit=new, autoMergeRequest=None,
              baseRefOid=base_oid)


def delete_head(pr, local):
    head = pr["head"]
    old = tip(head)
    if old:
        rgit("update-ref", "-d", f"refs/heads/{head}", old)
        log_push({"ref": f"refs/heads/{head}", "old": old, "new": "0" * len(old), "created": False, "deleted": True,
                  "forced": False, "rejected": False, "reason": None, "via": "merge", "pr": pr["number"]})
    for child in STATE["prs"]:
        if child["state"] == "OPEN" and child["base"] == head:
            child["base"] = pr["base"]
    if local and lgit("rev-parse", "--verify", "--quiet", f"refs/heads/{head}").returncode == 0:
        if lgit("symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip() == head:
            switched = lgit("checkout", "-q", pr["base"])
            if switched.returncode:
                warn(f"! Could not switch to branch {pr['base']}: {switched.stderr.strip()}")
                warn(f"✓ Deleted remote branch {head}")
                return
        lgit("branch", "-D", head)
        warn(f"✓ Deleted local branch {head} and switched to branch {pr['base']}")
    warn(f"✓ Deleted remote branch {head}")


