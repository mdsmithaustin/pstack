def execute_run(run):
    ci = STATE["ci"]
    run["attempt"] += 1
    run["startedAt"] = now()
    work = Path(tempfile.mkdtemp(prefix="runner-"))
    archive = rgit("archive", "--format=tar", run["sha"], text=False).stdout
    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
        tar.extractall(work, **({"filter": "tar"} if hasattr(tarfile, "tar_filter") else {}))
    proc = subprocess.Popen(ci["command"], shell=True, cwd=work, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, start_new_session=True, env=git_env())
    timeout = ci.get("timeout_s", 600)
    try:
        out, _ = proc.communicate(timeout=timeout)
        code = proc.returncode
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        out, _ = proc.communicate()
        code = None
    name = STATE["repo"].split("/")[1]
    text = out.decode("utf-8", "replace")
    for path in {str(work), os.path.realpath(work)}:
        text = text.replace(path, f"/__w/{name}/{name}")
    if code is None:
        text += f"\n##[error]The job has exceeded the maximum execution time of {timeout}s."
    elif code:
        text += f"\n##[error]Process completed with exit code {code}."
    shutil.rmtree(work, ignore_errors=True)
    lines = text.splitlines()
    (FORGE / "ci" / f"{run['id']}.log").write_text(text, encoding="utf-8")
    run.update(conclusion="SUCCESS" if code == 0 else "FAILURE", completedAt=now(), output="\n".join(lines[-200:]))


