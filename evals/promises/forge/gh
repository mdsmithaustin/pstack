def parse(args, spec):
    kinds, alias = {}, {}
    for item in spec.split():
        names, kind = item.split(":")
        names = names.split("|")
        for name in names:
            alias[name] = names[0]
        kinds[names[0]] = kind
    opts = {k: [] if kind == "list" else False if kind == "bool" else None for k, kind in kinds.items()}
    pos, i = [], 0
    while i < len(args):
        arg = args[i]
        i += 1
        if arg == "--":
            pos += args[i:]
            break
        if not arg.startswith("-") or arg == "-":
            pos.append(arg)
            continue
        name, eq, value = arg.lstrip("-").partition("=")
        key = alias.get(name)
        if key is None or (arg.startswith("--") != (len(name) > 1)):
            unsupported(f"unknown flag: {arg.split('=')[0]}" if arg.startswith("--")
                        else f"unknown shorthand flag: '{name[:1]}' in {arg}")
        if kinds[key] == "bool":
            opts[key] = value != "false" if eq else True
            continue
        if not eq:
            if i >= len(args) and key == "json":
                value = ""
            elif i >= len(args):
                fail(f"flag needs an argument: {arg}")
            else:
                value = args[i]
                i += 1
        if kinds[key] == "list":
            opts[key].append(value)
        else:
            opts[key] = value
    return opts, pos


def one_arg(pos, usage):
    if len(pos) > 1:
        fail(f"accepts at most 1 arg(s), received {len(pos)}\n\nUsage:  {usage}")
    return pos[0] if pos else None


def git_env(extra=None):
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    return {**env, "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1", **(extra or {})}


def rgit(*args, check=True, text=True, env=None):
    result = subprocess.run(["git", "--git-dir", str(REMOTE), *args], capture_output=True, text=text,
                            env=git_env(env))
    if check and result.returncode:
        raise RuntimeError(f"git {' '.join(args)}: {result.stderr}")
    return result


def lgit(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def tip(branch):
    return rgit("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False).stdout.strip() or None


def commit_of(rev):
    return rgit("rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}", check=False).stdout.strip() or None


def commits_between(base, head):
    out = rgit("log", "--reverse", "--format=%H%x1f%s%x1f%b%x1f%an%x1f%ae%x1f%aI%x1e", f"{base}..{head}").stdout
    rows = []
    for record in out.split("\x1e"):
        parts = record.strip("\n").split("\x1f")
        if len(parts) == 6:
            oid, subject, body, name, email, date = parts
            rows.append({"oid": oid, "messageHeadline": subject, "messageBody": body.strip(),
                         "authoredDate": date, "committedDate": date,
                         "authors": [{"name": name, "email": email, "login": ""}]})
    return rows


def numstat(base, head):
    files = []
    for line in rgit("diff", "--numstat", f"{base}...{head}").stdout.splitlines():
        added, deleted, path = line.split("\t", 2)
        files.append({"path": path, "additions": int(added) if added.isdigit() else 0,
                      "deletions": int(deleted) if deleted.isdigit() else 0})
    return files


