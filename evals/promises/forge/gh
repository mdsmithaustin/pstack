def jq(expr, value):
    try:
        program = JqParser(expr).program()
    except JqParseError as exc:
        unsupported(f"failed to parse jq expression (line 1, column {exc.args[0] + 1})\n    {expr}")
    try:
        return list(program(value))
    except JqError as exc:
        fail(str(exc))


def type_name(v):
    return ("null" if v is None else "boolean" if isinstance(v, bool) else "number" if isinstance(v, (int, float))
            else "string" if isinstance(v, str) else "array" if isinstance(v, list) else "object")


def truthy(v):
    return v is not None and v is not False


def rank(v):
    if isinstance(v, bool):
        return 2 if v else 1
    return {"null": 0, "number": 3, "string": 4, "array": 5, "object": 6}[type_name(v)]


def order(a, b):
    ra, rb = rank(a), rank(b)
    if ra != rb:
        return (ra > rb) - (ra < rb)
    if isinstance(a, list):
        for x, y in zip(a, b):
            c = order(x, y)
            if c:
                return c
        return (len(a) > len(b)) - (len(a) < len(b))
    if isinstance(a, dict):
        c = order(sorted(a), sorted(b))
        if c:
            return c
        for k in sorted(a):
            c = order(a[k], b[k])
            if c:
                return c
        return 0
    if isinstance(a, (int, float, str)) and not isinstance(a, bool):
        return (a > b) - (a < b)
    return 0


def index(v, k):
    if v is None:
        return None
    if isinstance(v, dict) and isinstance(k, str):
        return v.get(k)
    if isinstance(v, list) and isinstance(k, int) and not isinstance(k, bool):
        return v[k] if -len(v) <= k < len(v) else None
    expected = "an object" if isinstance(k, str) else "an array"
    raise JqError(f"expected {expected} but got: {type_name(v)} ({dumps(v)})")


def iterate(v):
    if isinstance(v, list):
        return list(v)
    if isinstance(v, dict):
        return list(v.values())
    raise JqError(f"cannot iterate over: {type_name(v)} ({dumps(v)})")


def contains(a, b):
    if type_name(a) != type_name(b):
        raise JqError(f"{type_name(a)} ({dumps(a)}) and {type_name(b)} ({dumps(b)}) cannot have their containment checked")
    if isinstance(a, str):
        return b in a
    if isinstance(a, list):
        return all(any(type_name(x) == type_name(y) and contains(x, y) for x in a) for y in b)
    if isinstance(a, dict):
        return all(k in a and type_name(a[k]) == type_name(v) and contains(a[k], v) for k, v in b.items())
    return a == b


def tostr(v):
    return v if isinstance(v, str) else dumps(v)


def tsv_cell(v):
    if v is None:
        return ""
    if isinstance(v, str):
        return v.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r")
    if isinstance(v, (list, dict)):
        raise JqError(f"{type_name(v)} ({dumps(v)}) is not valid in a csv row")
    return dumps(v)


def csv_cell(v):
    if isinstance(v, str):
        return '"' + v.replace('"', '""') + '"'
    return tsv_cell(v)


def string_arg(fn, x):
    for s in fn(x):
        if not isinstance(s, str):
            raise JqError(f"{type_name(s)} ({dumps(s)}) cannot be used as a string argument")
        yield s


class JqParser:
    IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
    NUMBER = re.compile(r"\d+(?:\.\d+)?")
    COMPARE = ("==", "!=", "<=", ">=", "<", ">")

    def __init__(self, src):
        self.s, self.i = src, 0

    def ws(self):
        while self.i < len(self.s) and self.s[self.i].isspace():
            self.i += 1

    def peek(self, tok):
        self.ws()
        return self.s.startswith(tok, self.i)

    def eat(self, tok):
        if self.peek(tok):
            self.i += len(tok)
            return True
        return False

    def expect(self, tok):
        if not self.eat(tok):
            raise JqParseError(self.i)

    def word(self):
        self.ws()
        m = self.IDENT.match(self.s, self.i)
        return m.group() if m else None

    def keyword(self, name):
        if self.word() == name:
            self.i += len(name)
            return True
        return False

    def program(self):
        node = self.pipe()
        self.ws()
        if self.i != len(self.s):
            raise JqParseError(self.i)
        return node

    def pipe(self):
        left = self.comma()
        if self.peek("|=") or not self.eat("|"):
            return left
        right = self.pipe()
        return lambda x: (z for y in left(x) for z in right(y))

    def comma(self):
        items = [self.alt()]
        while self.eat(","):
            items.append(self.alt())
        if len(items) == 1:
            return items[0]
        return lambda x: (y for f in items for y in f(x))

    def alt(self):
        left = self.or_()
        while self.eat("//"):
            right, first = self.or_(), left

            def node(x, first=first, right=right):
                found = []
                try:
                    found = [v for v in first(x) if truthy(v)]
                except JqError:
                    pass
                return iter(found) if found else right(x)
            left = node
        return left

    def or_(self):
        left = self.and_()
        while self.keyword("or"):
            right, first = self.and_(), left
            left = lambda x, a=first, b=right: (
                True if truthy(l) else truthy(r) for l in a(x) for r in ([None] if truthy(l) else b(x)))
        return left

    def and_(self):
        left = self.compare()
        while self.keyword("and"):
            right, first = self.compare(), left
            left = lambda x, a=first, b=right: (
                False if not truthy(l) else truthy(r) for l in a(x) for r in ([None] if not truthy(l) else b(x)))
        return left

    def compare(self):
        left = self.postfix()
        for op in self.COMPARE:
            if self.eat(op):
                right = self.postfix()
                test = {"==": lambda c: c == 0, "!=": lambda c: c != 0, "<": lambda c: c < 0,
                        "<=": lambda c: c <= 0, ">": lambda c: c > 0, ">=": lambda c: c >= 0}[op]
                return lambda x: (test(order(l, r)) for r in right(x) for l in left(x))
        return left

    def postfix(self):
        node = self.primary()
        while True:
            self.ws()
            if self.s.startswith(".", self.i) and self.i + 1 < len(self.s) and (
                    self.IDENT.match(self.s, self.i + 1) or self.s[self.i + 1] in '"['):
                self.i += 1
                node = self.suffix(node, dotted=True)
            elif self.peek("["):
                node = self.suffix(node, dotted=False)
            elif self.eat("?"):
                inner = node

                def node(x, inner=inner):
                    try:
                        return iter(list(inner(x)))
                    except JqError:
                        return iter(())
            else:
                return node

    def suffix(self, node, dotted):
        if dotted and self.s[self.i] != "[":
            key = self.field_name()
            return lambda x: (index(v, key) for v in node(x))
        self.expect("[")
        if self.eat("]"):
            return lambda x: (e for v in node(x) for e in iterate(v))
        key = self.pipe()
        self.expect("]")
        return lambda x: (index(v, k) for v in node(x) for k in key(x))

    def field_name(self):
        if self.s[self.i] == '"':
            parts = self.string_parts()
            if any(not isinstance(p, str) for p in parts):
                raise JqParseError(self.i)
            return "".join(parts)
        m = self.IDENT.match(self.s, self.i)
        self.i = m.end()
        return m.group()

    def string_parts(self):
        self.i += 1
        parts, buf = [], []
        escapes = {'"': '"', "\\": "\\", "/": "/", "n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f"}
        while self.i < len(self.s):
            c = self.s[self.i]
            self.i += 1
            if c == '"':
                parts.append("".join(buf))
                return parts
            if c != "\\":
                buf.append(c)
                continue
            if self.i >= len(self.s):
                break
            e = self.s[self.i]
            self.i += 1
            if e in escapes:
                buf.append(escapes[e])
            elif e == "u":
                buf.append(chr(int(self.s[self.i:self.i + 4], 16)))
                self.i += 4
            elif e == "(":
                parts.append("".join(buf))
                buf = []
                parts.append(self.pipe())
                self.expect(")")
            else:
                raise JqParseError(self.i)
        raise JqParseError(self.i)

    def string(self):
        parts = self.string_parts()

        def node(x):
            pools = [[p] if isinstance(p, str) else [tostr(v) for v in p(x)] for p in parts]
            return ("".join(combo) for combo in itertools.product(*pools))
        return node

    def primary(self):
        self.ws()
        if self.i >= len(self.s):
            raise JqParseError(self.i)
        c = self.s[self.i]
        if c == "." and not self.s.startswith("..", self.i):
            self.i += 1
            if self.i < len(self.s) and (self.IDENT.match(self.s, self.i) or self.s[self.i] == '"'):
                key = self.field_name()
                return lambda x: iter([index(x, key)])
            return lambda x: iter([x])
        if c == '"':
            return self.string()
        m = self.NUMBER.match(self.s, self.i)
        if m:
            self.i = m.end()
            value = float(m.group()) if "." in m.group() else int(m.group())
            return lambda x: iter([value])
        if self.eat("("):
            inner = self.pipe()
            self.expect(")")
            return inner
        if self.eat("["):
            if self.eat("]"):
                return lambda x: iter([[]])
            inner = self.pipe()
            self.expect("]")
            return lambda x: iter([list(inner(x))])
        if self.eat("{"):
            return self.obj()
        if self.eat("@tsv"):
            return lambda x: iter(["\t".join(tsv_cell(v) for v in self.row(x))])
        if self.eat("@csv"):
            return lambda x: iter([",".join(csv_cell(v) for v in self.row(x))])
        name = self.word()
        if name is None:
            raise JqParseError(self.i)
        self.i += len(name)
        return self.function(name)

    def row(self, x):
        if not isinstance(x, list):
            raise JqError(f"{type_name(x)} ({dumps(x)}) cannot be csv-formatted, only an array can be")
        return x

    def args(self, count):
        if count == 0:
            return []
        self.expect("(")
        args = [self.pipe()]
        while self.eat(";"):
            args.append(self.pipe())
        self.expect(")")
        if len(args) != count:
            raise JqParseError(self.i)
        return args

    def function(self, name):
        has_args = self.peek("(")
        constants = {"true": True, "false": False, "null": None}
        if name in constants and not has_args:
            return lambda x: iter([constants[name]])
        if not has_args:
            simple = {
                "empty": lambda x: [],
                "not": lambda x: [not truthy(x)],
                "length": lambda x: [self.length(x)],
                "keys": lambda x: [sorted(x) if isinstance(x, dict) else list(range(len(iterate(x))))],
                "first": lambda x: [index(x, 0)],
                "last": lambda x: [index(x, -1)],
                "any": lambda x: [any(truthy(v) for v in iterate(x))],
                "all": lambda x: [all(truthy(v) for v in iterate(x))],
            }
            if name not in simple:
                raise JqParseError(self.i)
            fn = simple[name]
            return lambda x: iter(fn(x))
        if name in ("select", "map", "first", "any", "all"):
            (f,) = self.args(1)
            return {
                "select": lambda x: (x for v in f(x) if truthy(v)),
                "map": lambda x: iter([[y for e in iterate(x) for y in f(e)]]),
                "first": lambda x: itertools.islice(f(x), 1),
                "any": lambda x: iter([any(truthy(y) for e in iterate(x) for y in f(e))]),
                "all": lambda x: iter([all(truthy(y) for e in iterate(x) for y in f(e))]),
            }[name]
        if name in ("join", "test", "startswith", "contains"):
            (f,) = self.args(1)
            if name == "contains":
                return lambda x: (contains(x, b) for b in f(x))
            if name == "join":
                return lambda x: (sep.join("" if v is None else tostr(v) for v in iterate(x))
                                  for sep in string_arg(f, x))
            check = {"test": lambda s, a: re.search(a, s) is not None, "startswith": lambda s, a: s.startswith(a)}[name]

            def node(x):
                if not isinstance(x, str):
                    raise JqError(f"{type_name(x)} ({dumps(x)}) cannot be matched, as it is not a string")
                return (check(x, a) for a in string_arg(f, x))
            return node
        raise JqParseError(self.i)

    @staticmethod
    def length(x):
        if x is None:
            return 0
        if isinstance(x, bool):
            raise JqError("boolean (" + dumps(x) + ") has no length")
        if isinstance(x, (int, float)):
            return abs(x)
        return len(x)

    def obj(self):
        entries = []
        if not self.eat("}"):
            while True:
                entries.append(self.entry())
                if self.eat("}"):
                    break
                self.expect(",")

        def node(x):
            pools = [[(k, v) for k in key(x) for v in val(x)] for key, val in entries]
            for combo in itertools.product(*pools):
                out = {}
                for k, v in combo:
                    if not isinstance(k, str):
                        raise JqError(f"object keys must be strings")
                    out[k] = v
                yield out
        return node

    def entry(self):
        self.ws()
        if self.s.startswith('"', self.i):
            key = self.string()
        elif self.eat("("):
            key = self.pipe()
            self.expect(")")
        else:
            name = self.word()
            if name is None:
                raise JqParseError(self.i)
            self.i += len(name)
            key = lambda x, name=name: iter([name])
        if not self.eat(":"):
            return key, lambda x: (index(x, k) for k in key(x))
        return key, self.objval()

    def objval(self):
        left = self.alt()
        if self.peek("|=") or not self.eat("|"):
            return left
        right = self.objval()
        return lambda x: (z for y in left(x) for z in right(y))


