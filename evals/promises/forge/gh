def cmd_run(args):
    specs = {"list": "branch|b:str json:str jq|q:str limit|L:str", "view": "log:bool log-failed:bool json:str jq|q:str",
             "rerun": "failed:bool"}
    if not args or args[0] not in specs:
        unsupported(f'unknown command "{args[0] if args else ""}" for "gh run"')
    opts, pos = parse(args[1:], specs[args[0]] + " repo|R:str")
    target(opts["repo"])
    if args[0] == "list":
        need_json(opts)
        runs = [r for r in all_runs() if opts["branch"] in (None, r["branch"])][:int(opts["limit"] or 20)]
        fields = json_fields(opts["json"], RUN_FIELDS)
        if fields:
            emit([export(r, fields, RUN_FIELDS) for r in runs], opts["jq"])
            return
        for r in runs:
            say(f"completed\t{r['conclusion'].lower()}\t{r['title']}\t{STATE['ci']['name']}\t{r['branch']}\t"
                f"pull_request\t{r['id']}\t12s\t{r['startedAt']}")
        return
    need_json(opts)
    fields = json_fields(opts.get("json"), RUN_FIELDS)
    run = find_run(one_arg(pos, f"gh run {args[0]} [<run-id>] [flags]"))
    if args[0] == "rerun":
        if opts["failed"] and run["conclusion"] == "SUCCESS":
            fail(f"run {run['id']} cannot be rerun; its workflow file may be broken")
        execute_run(run)
        return
    if fields:
        emit(export(run, fields, RUN_FIELDS), opts["jq"])
        return
    name = STATE["ci"]["name"]
    if opts["log"] or opts["log-failed"]:
        if opts["log-failed"] and run["conclusion"] == "SUCCESS":
            return
        for line in run["output"].splitlines():
            say(f"{name}\tRun {STATE['ci']['command']}\t{run['completedAt']} {line}")
        return
    mark = "✓" if run["conclusion"] == "SUCCESS" else "X"
    say(f"\n{mark} {run['branch']} {name} · {run['id']}\nTriggered via pull_request\n\nJOBS\n"
        f"{mark} {name} in 12s (ID {run['job']})\n\nFor more information about the job, try: "
        f"gh run view --job={run['job']}\nView this run on GitHub: {repo_url()}/actions/runs/{run['id']}")


