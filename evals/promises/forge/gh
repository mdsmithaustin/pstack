def select_pr(arg):
    if arg is None:
        arg = current_branch()
        matches = [pr for pr in STATE["prs"] if pr["head"] == arg]
        if not matches:
            fail(f'no pull requests found for branch "{arg}"')
        return sorted(matches, key=lambda pr: (pr["state"] == "OPEN", pr["number"]))[-1]
    match = re.match(r"^https?://github\.com/([^/]+/[^/]+)/pull/(\d+)", arg)
    if match:
        target(match.group(1))
        return find_pr(int(match.group(2)))
    if re.fullmatch(r"#?\d+", arg):
        return find_pr(int(arg.lstrip("#")))
    matches = [pr for pr in STATE["prs"] if pr["head"] == arg]
    if not matches:
        fail(f'no pull requests found for branch "{arg}"')
    return sorted(matches, key=lambda pr: (pr["state"] == "OPEN", pr["number"]))[-1]


