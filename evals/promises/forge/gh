def json_fields(spec, table):
    if spec is None:
        return None
    names = [f.strip() for f in spec.split(",") if f.strip()]
    listing = "\n".join(f"  {name}" for name in sorted(table))
    if not names:
        fail(f"Specify one or more comma-separated fields for `--json`:\n{listing}")
    for name in names:
        if name not in table:
            fail(f'Unknown JSON field: "{name}"\nAvailable fields:\n{listing}')
    return sorted(set(names))


