def require_body(body):
    if "body" not in body:
        raise HttpError(422, 'Invalid request.\n\n"body" wasn\'t supplied.')
    return body["body"]


REVIEW_EVENTS = {"APPROVE": "APPROVED", "REQUEST_CHANGES": "CHANGES_REQUESTED", "COMMENT": "COMMENTED", None: "PENDING"}


def pr_route(method, rest_of, pr, nums, body):
    if (method, rest_of) == ("GET", ""):
        return rest_pr(pr)
    if (method, rest_of) == ("GET", "/reviews"):
        return [rest_review(pr, r) for r in pr["reviews"]]
    if (method, rest_of) == ("POST", "/reviews"):
        event = body.get("event")
        if event not in REVIEW_EVENTS:
            raise HttpError(422, "Unprocessable Entity")
        if event in ("APPROVE", "REQUEST_CHANGES") and pr["author"] == STATE["user"]:
            verb = "approve" if event == "APPROVE" else "request changes on"
            raise HttpError(422, f"Can not {verb} your own pull request")
        review = {"id": new_id(), "author": STATE["user"], "state": REVIEW_EVENTS[event], "body": body.get("body", ""),
                  "commit": body.get("commit_id") or pr["headRefOid"], "submittedAt": now()}
        pr["reviews"].append(review)
        for c in body.get("comments", []):
            add_thread(pr, c.get("path"), c.get("line"), c.get("body", ""), review["id"])
        return rest_review(pr, review)
    if (method, rest_of) == ("GET", "/requested_reviewers"):
        return {"users": [rest_user(r) for r in pr["reviewRequests"]], "teams": []}
    if (method, rest_of) == ("GET", "/comments"):
        return [rest_review_comment(pr, t, c) for t in pr["threads"] for c in t["comments"]]
    if (method, rest_of) == ("POST", "/comments"):
        text = require_body(body)
        if body.get("in_reply_to") is not None:
            return reply(pr, int(body["in_reply_to"]), text)
        line = body.get("line") or body.get("position")
        if not body.get("path") or not line:
            raise HttpError(422, "pull_request_review_thread.line must be part of the diff")
        thread, comment = add_thread(pr, body["path"], line, text, None)
        return rest_review_comment(pr, thread, comment)
    if (method, rest_of) == ("POST", "/comments/{n}/replies"):
        return reply(pr, nums[1], require_body(body))
    raise HttpError(404, "Not Found", True)


def rest(method, path, params, body):
    if (method, path) == ("GET", "user"):
        return {**rest_user(STATE["user"]), "name": None, "public_repos": 1}
    match = re.fullmatch(r"repos/([^/]+)/([^/]+)(/.*)?", path)
    if not match:
        raise HttpError(404, "Not Found", True)
    if f"{match.group(1)}/{match.group(2)}".lower() != STATE["repo"].lower():
        raise HttpError(404, "Not Found")
    sub = match.group(3) or ""
    commit = re.fullmatch(r"/commits/(.+)/(check-runs|status)", sub)
    nums = [int(n) for n in re.findall(r"/(\d+)(?=/|$)", sub)]
    shape = re.sub(r"/\d+(?=/|$)", "/{n}", sub)
    if (method, sub) == ("GET", ""):
        owner, name = STATE["repo"].split("/")
        return {"id": 700000001, "name": name, "full_name": STATE["repo"], "owner": rest_user(owner),
                "private": True, "html_url": repo_url(), "default_branch": "main"}
    if (method, sub) == ("GET", "/pulls"):
        state = params.get("state", "open")
        head = str(params.get("head", "")).split(":")[-1]
        return [rest_pr(pr) for pr in sorted(STATE["prs"], key=lambda p: -p["number"])
                if (state == "all" or (pr["state"] == "OPEN") == (state == "open"))
                and head in ("", pr["head"]) and params.get("base") in (None, pr["base"])]
    if shape.startswith("/pulls/{n}"):
        pr = next((p for p in STATE["prs"] if p["number"] == nums[0]), None)
        if pr is None:
            raise HttpError(404, "Not Found")
        derive(pr)
        return pr_route(method, shape[len("/pulls/{n}"):], pr, nums, body)
    if shape == "/issues/{n}/comments" and method in ("GET", "POST"):
        item = find_item(nums[0])
        if item is None:
            raise HttpError(404, "Not Found")
        if method == "GET":
            return [rest_issue_comment(item, c) for c in item["comments"]]
        comment = {"id": new_id(), "author": STATE["user"], "body": require_body(body), "createdAt": now()}
        item["comments"].append(comment)
        return rest_issue_comment(item, comment)
    branch = re.fullmatch(r"/(rules/branches|branches)/(.+?)(/protection)?", sub)
    if branch and method == "GET" and branch.group(1) == "rules/branches" and not branch.group(3):
        rule = {"type": "pull_request", "ruleset_source_type": "Repository", "ruleset_source": STATE["repo"]}
        return [rule] if branch.group(2) in STATE["protected"] else []
    if branch and method == "GET" and branch.group(1) == "branches" and branch.group(3):
        if branch.group(2) not in STATE["protected"]:
            raise HttpError(404, "Branch not protected")
        return {"url": f"{api_base()}/branches/{branch.group(2)}/protection",
                "required_pull_request_reviews": {"required_approving_review_count": 0},
                "allow_force_pushes": {"enabled": False}, "allow_deletions": {"enabled": False}}
    if shape == "/actions/runs/{n}" and method == "GET":
        run = next((r for r in STATE["runs"].values() if r["id"] == nums[0]), None)
        if run is None:
            raise HttpError(404, "Not Found")
        return {"id": run["id"], "head_sha": run["sha"], "head_branch": run["branch"], "run_attempt": run["attempt"],
                "status": "completed", "conclusion": run["conclusion"].lower(), "name": STATE["ci"]["name"],
                "html_url": f"{repo_url()}/actions/runs/{run['id']}", "event": "pull_request"}
    if shape == "/issues/comments/{n}" and method == "PATCH":
        found = next(((item, c) for item in STATE["prs"] + STATE["issues"] for c in item["comments"] if c["id"] == nums[0]), None)
        if found is None:
            raise HttpError(404, "Not Found")
        found[1]["body"] = require_body(body)
        return rest_issue_comment(*found)
    if commit and method == "GET":
        sha = commit_of(commit.group(1))
        if sha is None:
            raise HttpError(422, f"No commit found for SHA: {commit.group(1)}")
        if commit.group(2) == "check-runs":
            runs = check_runs(sha)
            return {"total_count": len(runs), "check_runs": runs}
        return {"state": "pending", "statuses": [], "sha": sha, "total_count": 0,
                "repository": {"full_name": STATE["repo"]}}
    raise HttpError(404, "Not Found", True)


