def canned_checks(pr):
    checks = []
    for canned in pr["checks"]:
        conclusion = (canned.get("conclusion") or "").upper() or None
        if conclusion in ("PENDING", "QUEUED", "IN_PROGRESS"):
            conclusion = None
        checks.append({"name": canned["name"], "workflow": canned.get("workflow", ""),
                       "status": "COMPLETED" if conclusion else "IN_PROGRESS", "conclusion": conclusion,
                       "link": f"{pr_url(pr)}/checks", "startedAt": pr["createdAt"],
                       "completedAt": pr["createdAt"] if conclusion else None})
    return checks


def derive(pr):
    if pr["state"] != "OPEN" or pr["number"] in DERIVED:
        return
    DERIVED.add(pr["number"])
    pr["headRefOid"] = tip(pr["head"]) or pr["headRefOid"]
    pr["baseRefOid"] = tip(pr["base"]) or pr["baseRefOid"]
    clean = rgit("merge-tree", "--write-tree", "--no-messages", pr["baseRefOid"], pr["headRefOid"],
                 check=False).returncode == 0
    pr["mergeable"] = "MERGEABLE" if clean else "CONFLICTING"


def merge_state(pr):
    derive(pr)
    if pr["state"] == "OPEN":
        if pr["mergeable"] == "CONFLICTING":
            pr["mergeStateStatus"] = "DIRTY"
        elif any(bucket(c) in ("fail", "pending") for c in checks_for(pr)):
            pr["mergeStateStatus"] = "BLOCKED"
        else:
            pr["mergeStateStatus"] = "CLEAN"
    return pr["mergeStateStatus"]


