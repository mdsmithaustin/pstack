URL_RE = re.compile(r"^(?:(?:ssh://)?(?:[\w.-]+@)?github\.com[:/]/?|https?://(?:[^@/]+@)?github\.com/)"
                    r"([^/]+)/([^/]+?)(?:\.git)?/?$")


def target(flag=None):
    given = flag or os.environ.get("GH_REPO")
    if given:
        name = re.sub(r"^(?:https?://)?github\.com/", "", given).removesuffix(".git").strip("/")
        if name.count("/") != 1:
            fail(f'expected the "[HOST/]OWNER/REPO" format, got "{given}"')
    else:
        name = origin_repo()
    if name.lower() != STATE["repo"].lower():
        fail(f"GraphQL: Could not resolve to a Repository with the name '{name}'. (repository)")
    return STATE["repo"]


def origin_repo():
    if lgit("rev-parse", "--git-dir").returncode:
        fail("failed to run git: fatal: not a git repository (or any of the parent directories): .git")
    remotes = {}
    for line in lgit("config", "--get-regexp", r"^remote\..*\.url$").stdout.splitlines():
        key, _, url = line.partition(" ")
        remotes[key[len("remote."):-len(".url")]] = url
    if not remotes:
        fail("no git remotes found")
    order = sorted(remotes, key=lambda r: (["upstream", "github", "origin"] + [r]).index(r))
    for name in order:
        match = URL_RE.match(remotes[name])
        if match:
            return f"{match.group(1)}/{match.group(2)}"
    fail("none of the git remotes configured for this repository point to a known GitHub host. "
         "To tell gh about a new GitHub host, please use `gh auth login`")


