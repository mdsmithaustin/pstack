{
  "stale-summary": {
    "bootstrap": "stale_summary.py",
    "minimum_signals": 1,
    "states": [
      {"name": "current", "exit": "zero", "required_operations": ["tools/run-checks.py"]},
      {"name": "count-changed", "exit": "zero", "required_operations": ["tools/run-checks.py"]},
      {"name": "broken", "exit": "nonzero", "required_operations": ["tools/run-checks.py"]}
    ]
  },
  "empty-selection": {
    "bootstrap": "empty_selection.py",
    "minimum_signals": 2,
    "states": [
      {"name": "present", "exit": "zero", "required_operations": ["run-scenarios.py --list", "run-scenarios.py --name checkout_rejects_expired_card"]},
      {"name": "absent", "exit": "nonzero", "required_operations": ["run-scenarios.py --list"]},
      {"name": "scenario-broken", "exit": "nonzero", "required_operations": ["run-scenarios.py --list", "run-scenarios.py --name checkout_rejects_expired_card"]}
    ]
  },
  "defaulted-parity": {
    "bootstrap": "defaulted_parity.py",
    "minimum_signals": 3,
    "states": [
      {"name": "equal", "exit": "zero", "required_operations": ["tools/reference_total.py", "tools/current_total.py"]},
      {"name": "unequal", "exit": "nonzero", "required_operations": ["tools/reference_total.py", "tools/current_total.py"]},
      {"name": "reference-unavailable", "exit": "nonzero", "required_operations": ["tools/reference_total.py"]},
      {"name": "current-unavailable", "exit": "nonzero", "required_operations": ["tools/reference_total.py", "tools/current_total.py"]},
      {"name": "both-unavailable", "exit": "nonzero", "required_operations": ["tools/reference_total.py"]}
    ]
  },
  "package-path": {
    "bootstrap": "package_path.py",
    "minimum_signals": 1,
    "states": [
      {"name": "healthy", "exit": "zero", "required_operations": ["packages/web/scripts/check-release.py"]},
      {"name": "package-broken", "exit": "nonzero", "required_operations": ["packages/web/scripts/check-release.py"]},
      {"name": "root-decoy", "exit": "zero", "required_operations": ["packages/web/scripts/check-release.py"]}
    ]
  },
  "scoped-source": {
    "bootstrap": "scoped_source.py",
    "minimum_signals": 1,
    "states": [
      {"name": "migrated", "exit": "zero", "required_operations": ["verify-scenario.py legacy_fetch_uses_new_client"]},
      {"name": "target-regressed", "exit": "nonzero", "required_operations": ["verify-scenario.py legacy_fetch_uses_new_client"]},
      {"name": "compatibility-retained", "exit": "zero", "required_operations": ["verify-scenario.py legacy_fetch_uses_new_client"]}
    ]
  },
  "healthy-control": {
    "bootstrap": "healthy_control.py",
    "minimum_signals": 1,
    "states": [
      {"name": "healthy", "exit": "zero", "required_operations": ["tools/verify-release.py"]},
      {"name": "broken", "exit": "nonzero", "required_operations": ["tools/verify-release.py"]}
    ]
  }
}
