# Behavioral eval runs write raw agent transcripts. Never commit them.
# Leading **/ so the rules reach a runs directory wherever a run writes one,
# not only the one at the repository root. That includes the per-skill evals
# tree tools/test_eval_artifacts.py now forbids, which keeps a transcript out
# of git even on the layout the lint rejects.
**/evals/**/runs/
**/eval-runs/
/evals/**/answer-design.json
/evals/**/benchmark.json
/evals/**/benchmark-objective.json
/evals/**/events.json
/evals/**/exposure.json
/evals/**/grade.json
/evals/**/judge.jsonl
/evals/**/metrics.json
/evals/**/output.md
/evals/**/report.md
/evals/**/trace.jsonl
/evals/**/trigger-matrix.json
/evals/**/tasks.jsonl
/evals/**/tasks.all.jsonl
/evals/**/compare-tasks.jsonl
/evals/**/compare-truth.json
/evals/**/compare-results.jsonl
/evals/**/compare-summary.json
/evals/**/answers/
/evals/**/judge-transcripts/
.private-evals/
evals/direct-skills-foundation-decisions.tsv

# Harvest review sheets awaiting a human tick or strike. They quote real user
# prompts, so they stay out of git until reviewed.
**/review-inbox/
